*****************************************************************
* INFINEON Power Transistors                                    *
* Level-1 / 3 PSPICE Library for OptiMOS2 n-Channel Transistors *
* Version 140504                                                *
*                                                               *
*****************************************************************
* simulation support:  simulate@infineon.com                    *
*                                                               *
* internet          :  www.infineon.com/simulate                *
*****************************************************************
*                                                               *
* Models provided by Infineon are not warranted by Infineon as  *
* fully representing all the specifications and operating       *
* characteristics of the semiconductor product to which the     *
* model relates. The models describe the characteristics of     *
* typical devices.                                              *
* In all cases, the current data sheet information for a given  *
* device is the final design guideline and the only actual      *
* performance specification.                                    *
* Although models can be a useful tool in evaluating device     *
* performance, they cannot model exact device performance under *
* all conditions, nor are they intended to replace bread-       *
* boarding for final verification. INFINEON therefore does not  *
* assume any liability arising from their use.                  *
* INFINEON reserves the right to change models without prior    *
* notice.                                                       *
*                                                               *
* This library contains models of the following INFINEON        *
* OptiMOS2 transistors:                                         *
*                                                               *
*   25V LL                                                      *
*  IPB03N03LA      IPD03N03LA      IPI03N03LA      IPP03N03LA   *
*  IPB04N03LA      IPD04N03LA      IPF04N03LA      IPI04N03LA   *
*  IPP04N03LA      IPU04N03LA      IPDH4N03LA      IPB05N03LA   *
*  IPD05N03LA      IPF05N03LA      IPI05N03LA      IPP05N03LA   *
*  IPU05N03LA      IPB06N03LA      IPD06N03LA      IPF06N03LA   *
*  IPI06N03LA      IPP06N03LA      IPU06N03LA      IPB09N03LA   *
*  IPD09N03LA      IPF09N03LA      IPI09N03LA      IPP09N03LA   *
*  IPU09N03LA      IPD10N03LA      IPF10N03LA      IPU10N03LA   *
*  IPB11N03LA      IPI11N03LA      IPP11N03LA      IPD13N03LA   *
*  IPF13N03LA      IPU13N03LA      IPB14N03LA      IPI14N03LA   *
*  IPP14N03LA                                                   *
*                                                               *
*   30V LL                                                      *
*  IPD03N03LB      IPD04N03LB      IPD05N03LB      IPD06N03LB   *
*  IPD09N03LB      IPD12N03LB                                   *
*  BSO052N03S      BSO064N03S      BSO072N03S      BSO094N03S   *
*  BSO104N03S      BSO119N03S      BSO200N03S      BSO300N03S   *
*  BSO150N03       BSO350N03                                    *
*  BSC022N03S      BSC032N03S      BSC042N03S      BSC052N03S   *
*  BSC059N03S                                                   *
*****************************************************************
* thermal nodes of level 3 models:                              *
*                                                               *
*  .SUBCKT IPP05N03LA drain gate source Tj Tcase                *
*  Tj :    potential=temperature (in °C) at junction (typically *
*          not connected)                                       *
*  Tcase : node where the boundary contition - external heat    *
*          sinks etc - have to be connected (ideal heat sink    *
*          can be modeled by using a voltage source stating the *
*          ambient temperature in °C between Tcase and ground.  *
*                                                               *
*****************************************************************
*$
.SUBCKT S3_30_l_var dd g s0 Tj PARAMS: a=1 dVth=0 dR=0 dgfs=0 Inn=1 Unn=1 Rmax=1
+mos_gmin=1 Rs=1 Rp=1 dC=0 Rm=1u

.PARAM  Fm=0.1       Fn=0.5
.PARAM  c=1.08       Vth0=2.5    auth=3.27m
.PARAM  UT=100m      ab=40m      lB=-23       UB=34

.PARAM  b0=50.25     p0=8.7888   p1=-31.4m    p2=45u

.PARAM  Rd=9.6m      nmu=3.5     Tref=298     T0=273       lnIsj=-28.44
.PARAM  ndi=1        Rdi=3.6m    nmu2=0       ta=3n        td=20n
.PARAM  Rf=0.7       nmu3=1.4

.PARAM  f1=239p      f2=479p     f3=540p      U0=3       nc=0.5    nd=0.56
.PARAM  g1=6.5       bb=0.5      remp=5p
.PARAM  kbq=85.8u

.PARAM  Vmin=2.1     Vmax=2.9    dCmax=0.33
.PARAM  Vth={Vth0+(Vmax-Vth0)*limit(dVth,0,1)-(Vmin-Vth0)*limit(dVth,-1,0)}
.PARAM  q0={b0*((T0/Tref)**nmu3)*a}
.PARAM  q1={(Unn-Inn*Rs-Vth0)*q0}
.PARAM  q2={(Fm*SQRT(0.4)-c)*Inn*q0}
.PARAM  Rlim={(q1+2*q2*Rmax-SQRT(q1**2+4*q2))/(2*q2)}
.PARAM  dRd={Rd/a+if(dVth==0,limit(dR,0,1)*max(Rlim-Rd/a-Rs-Rp,0),0)}
.PARAM  bm={c/((1/mos_gmin-Rs)**2*Inn*a*(T0/Tref)**nmu3)}
.PARAM  bet={b0+(b0-bm)*if(dR==0,if(dVth==0,limit(dgfs,-1,0),0),0)}
.PARAM  dC1={1+dCmax*limit(dC,0,1)}
.PARAM  dC2={1+1.5*dCmax*limit(dC,0,1)}

.PARAM  Cox={f1*a*dC2}
.PARAM  Cox1={remp*SQRT(a)*dC2}
.PARAM  Cds0={f2*a*dC1}
.PARAM  Cgs0={f3*a*dC1}
.PARAM  dRdi={Rdi/a}

.FUNC  I0(Uee,p,pp,z1)  {if(Uee>pp,(Uee-c*z1)*z1,p*(pp-p)/c*exp((Uee-pp)/p))}
.FUNC  Ig(Uds,T,p,Uee)  {bet*(T0/T)**nmu3*I0(Uee,p,min(2*p,p+c*Uds),min(Uds,Uee/(2*c)))}
.FUNC J(d,g,T,da,s) 
+ {a*(s*(Ig(da,T,(p0+(p1+p2*T)*T)*kbq*T,g-Vth+auth*(T-Tref)+Fm*da**Fn+1*limit(-d,0,1))+exp(min(lB+(da-UB-ab*(T-Tref))/UT,25))))}

.FUNC  Idiode(Usd,Tj,Iss) {exp(min(log(Iss)+Usd/(ndi*kbq*Tj),7))-Iss}
.FUNC  Idiod(Usd,Tj)      {a*Idiode(Usd,Tj,exp(min(lnIsj+(Tj/Tref-1)*1.12/(ndi*kbq*Tj),7))*(Tj/Tref)**1.5)}

E_Edg     d   ox  VALUE {max(V(d,g),-bb)-(1/(g1*(1-nc))*((1/(1+g1*max(V(d,g)+bb,0)))**(nc-1)-(1/(1+g1*bb))**(nc-1)))}
C_Cdg    ox    g  {Cox}
Vx        d   ox1 0
C_Cdg1   ox1   g  {Cox1}

E_Eds     d edep  VALUE {(V(d,s)-I(V_sense3)/Cds0)}
C_Cds  edep    s  {Cds0}

C_Cgs   g    s   {Cgs0}

G_chan    d    s VALUE={J(V(d,s),V(g,s),T0+limit(V(Tj),-200,300),abs(V(d,s)),sgn(V(d,s)))}
G_RMos   d1    d  VALUE={V(d1,d)/(Rf*dRd+(1-Rf)*dRd*((limit(V(Tj),-200,999)+T0)/Tref)**nmu)}
V_sense  dd   d1  0
G_diode   s   d3  VALUE={Idiod(V(s,d3),T0+limit(V(Tj),-200,499))}
G_Rdio   d2   d1  VALUE={V(d2,d1)/(dRdi*((limit(V(Tj),-200,999)+T0)/Tref)**nmu2)}
V_sense2 d2   d3  0

L_L001    a    c  {td/(ta+td)}
R_R001    a    b  {1/ta}
V_sense3  c    0  0
E_E001    b    0  VALUE {I(V_sense2)}
E_E002    e    0  VALUE {Cds0*1/(1-nd)*U0**nd*(limit(U0+V(d1,s),0,2*UB))**(1-nd)}
R_R002    e    c  1
R_R003    a    0  500Meg

R1        g    s  1G
Rd01      d    s  500Meg
Rd02     d2    s  500Meg
Rd03     d1    d  1k

Rmet      s    s0 {Rm}

G_TH      0   Tj  VALUE =
+{(LIMIT(I(V_sense2)*V(d1,s)+(V(s,s0)**2)/Rm+(I(V_sense)-I(V_sense2))*V(d1,d)+
+(I(V_sense)-I(V_sense2)-I(E_Edg)-I(Vx)-I(E_Eds))*V(d,s),-10k,100k))}

.ENDS
*$
.SUBCKT S3_30_l_var1 dd g s0 Tj PARAMS: a=1 dVth=0 dR=0 dgfs=0 Inn=1 Unn=1 Rmax=1
+mos_gmin=1 Rs=1 Rp=1 dC=0 Rm=1u

.PARAM  Fm=0.1       Fn=0.5
.PARAM  c=1.08       Vth0=2.5    auth=3.27m
.PARAM  UT=100m      ab=40m      lB=-23       UB={34}

.PARAM  b0=50.25     p0=8.7888   p1=-31.4m    p2=45u

.PARAM  Rd=9.6m      nmu=3.5     Tref=298     T0=273       lnIsj=-28.44
.PARAM  ndi=1        Rdi=3.6m    nmu2=0       ta=3n        td=20n
.PARAM  Rf=0.7       nmu3=1.4

.PARAM  f1=239p      f2=479p     f3=540p      U0=3       nc=0.5    nd=0.56
.PARAM  g1=6.5       bb=0.5      remp=5p
.PARAM  kbq=85.8u

.PARAM  Vmin=2.1     Vmax=2.9    dCmax=0.33
.PARAM  Vth={Vth0+(Vmax-Vth0)*limit(dVth,0,1)-(Vmin-Vth0)*limit(dVth,-1,0)}
.PARAM  q0={b0*((T0/Tref)**nmu3)*a}
.PARAM  q1={(Unn-Inn*Rs-Vth0)*q0}
.PARAM  q2={(Fm*SQRT(0.4)-c)*Inn*q0}
.PARAM  Rlim={(q1+2*q2*Rmax-SQRT(q1**2+4*q2))/(2*q2)}
.PARAM  dRd={Rd/a+if(dVth==0,limit(dR,0,1)*max(Rlim-Rd/a-Rs-Rp,0),0)}
.PARAM  bm={c/((1/mos_gmin-Rs)**2*Inn*a*(T0/Tref)**nmu3)}
.PARAM  bet={b0+(b0-bm)*if(dR==0,if(dVth==0,limit(dgfs,-1,0),0),0)}
.PARAM  dC1={1+dCmax*limit(dC,0,1)}
.PARAM  dC2={1+1.5*dCmax*limit(dC,0,1)}

.PARAM  Cox={f1*a*dC2}
.PARAM  Cox1={remp*SQRT(a)*dC2}
.PARAM  Cds0={f2*a*dC1}
.PARAM  Cgs0={f3*a*dC1}
.PARAM  dRdi={Rdi/a}

.FUNC  I0(Uee,p,pp,z1)  {if(Uee>pp,(Uee-c*z1)*z1,p*(pp-p)/c*exp((Uee-pp)/p))}
.FUNC  Ig(Uds,T,p,Uee)  {bet*(T0/T)**nmu3*I0(Uee,p,min(2*p,p+c*Uds),min(Uds,Uee/(2*c)))}
.FUNC  J(d,g,T,da) 
+ {a*(sgn(d)*Ig(da,T,(p0+(p1+p2*T)*T)*kbq*T,g-Vth+auth*(T-Tref)+Fm*da**Fn+1*limit(-d,0,1)))}

E_Edg     d   ox  VALUE {max(V(d,g),-bb)-(1/(g1*(1-nc))*((1/(1+g1*max(V(d,g)+bb,0)))**(nc-1)-(1/(1+g1*bb))**(nc-1)))}
C_Cdg    ox   g   {Cox}
C_Cdg1   d    g   {Cox1}

Dbody s dd dbody
.model dbody D (BV= {UB},CJO ={Cds0},TT ={ta},IS ={a*exp(lnIsj)} m={0.35} RS={dRdi} )

C_Cgs   g    s   {Cgs0}

G_chan    d    s VALUE={J(V(d,s),V(g,s),T0+limit(V(Tj),-200,300),abs(V(d,s)))}
G_RMos   dd    d  VALUE={V(dd,d)/(Rf*dRd+(1-Rf)*dRd*((limit(V(Tj),-200,999)+T0)/Tref)**nmu)}

R1        g    s  1G
Rd01      d    s  500Meg
Rd03     dd    d  1k
Rd04     g     d  500Meg

Rmet      s    s0 {Rm}  TC=4m

Rx Tj 0 1k

.ENDS
*$
.SUBCKT S3_25_m_var dd g s0 Tj PARAMS: a=1 dVth=0 dR=0 dgfs=0 Inn=1 Unn=1 Rmax=1
+mos_gmin=1 Rs=1 Rp=1 dC=0 Rm=1u

.PARAM  Fm=0.12      Fn=0.5
.PARAM  c=1.2        Vth0=2.55   auth=3.3m       
.PARAM  UT=100m      ab=22.7m    lB=-23       UB=27
  
.PARAM  b0=49.7      p0=8.7888   p1=-31.4m    p2=45u

.PARAM  Rd=8.7m      nmu=3.5     Tref=298     T0=273       lnIsj=-28.44
.PARAM  ndi=1        Rdi=3.6m    nmu2=0.5     ta=3n        td=20n
.PARAM  Rf=0.7       nmu3=1.6

.PARAM  f1=293p      f2=479p     f3=540p      U0=2.8       nc=0.5  
.PARAM  g1=10        bb=0.3
.PARAM  kbq=85.8u

.PARAM  Vmin=2.1     Vmax=2.9    dCmax=0.33
.PARAM  Vth={Vth0+(Vmax-Vth0)*limit(dVth,0,1)-(Vmin-Vth0)*limit(dVth,-1,0)}
.PARAM  q0={b0*((T0/Tref)**nmu3)*a}
.PARAM  q1={(Unn-Inn*Rs-Vth0)*q0}
.PARAM  q2={(Fm*SQRT(0.4)-c)*Inn*q0}
.PARAM  Rlim={(q1+2*q2*Rmax-SQRT(q1**2+4*q2))/(2*q2)}
.PARAM  dRd={Rd/a+if(dVth==0,limit(dR,0,1)*max(Rlim-Rd/a-Rs-Rp,0),0)}
.PARAM  bm={c/((1/mos_gmin-Rs)**2*Inn*a*(T0/Tref)**nmu3)}
.PARAM  bet={b0+(b0-bm)*if(dR==0,if(dVth==0,limit(dgfs,-1,0),0),0)}
.PARAM  dC1={1+dCmax*limit(dC,0,1)}
.PARAM  dC2={1+1.5*dCmax*limit(dC,0,1)}

.PARAM  Cox={f1*a*dC2}
.PARAM  Cds0={f2*a*dC1}
.PARAM  Cgs0={f3*a*dC1}
.PARAM  dRdi={Rdi/a}

.FUNC  I0(Uee,p,pp,z1)  {if(Uee>pp,(Uee-c*z1)*z1,p*(pp-p)/c*exp((Uee-pp)/p))}
.FUNC  Ig(Uds,T,p,Uee)  {bet*(T0/T)**nmu3*I0(Uee,p,min(2*p,p+c*Uds),min(Uds,Uee/(2*c)))}
.FUNC J(d,g,T,da,s) 
+ {a*(s*(Ig(da,T,(p0+(p1+p2*T)*T)*kbq*T,g-Vth+auth*(T-Tref)+Fm*da**Fn+1*limit(-d,0,1))+exp(min(lB+(da-UB-ab*(T-Tref))/UT,25))))}

.FUNC  Idiode(Usd,Tj,Iss) {exp(min(log(Iss)+Usd/(ndi*kbq*Tj),7))-Iss}
.FUNC  Idiod(Usd,Tj)      {a*Idiode(Usd,Tj,exp(min(lnIsj+(Tj/Tref-1)*1.12/(ndi*kbq*Tj),7))*(Tj/Tref)**1.5)}

E_Edg     d   ox  VALUE {max(V(d,g),-bb)-(1/(g1*(1-nc))*((1/(1+g1*max(V(d,g)+bb,0)))**(nc-1)-(1/(1+g1*bb))**(nc-1)))}
C_Cdg    ox    g  {Cox}

E_Eds     d edep  VALUE {(V(d,s)-I(V_sense3)/Cds0)}
C_Cds  edep    s  {Cds0}

C_Cgs   g    s   {Cgs0}

G_chan    d    s VALUE={J(V(d,s),V(g,s),T0+limit(V(Tj),-200,300),abs(V(d,s)),sgn(V(d,s)))}
G_RMos   d1    d  VALUE={V(d1,d)/(Rf*dRd+(1-Rf)*dRd*((limit(V(Tj),-200,999)+T0)/Tref)**nmu)}
V_sense  dd   d1  0
G_diode   s   d3  VALUE={Idiod(V(s,d3),T0+limit(V(Tj),-200,499))}
G_Rdio   d2   d1  VALUE={V(d2,d1)/(dRdi*((limit(V(Tj),-200,999)+T0)/Tref)**nmu2)}
V_sense2 d2   d3  0

L_L001    a    c  {td/(ta+td)}
R_R001    a    b  {1/ta}
V_sense3  c    0  0
E_E001    b    0  VALUE {I(V_sense2)}
E_E002    e    0  VALUE {Cds0*2*(SQRT(U0*(limit(U0+V(d,s),0,2*UB))))}
R_R002    e    c  1
R_R003    a    0  500Meg

R1        g    s  1G
Rd01      d    s  500Meg
Rd02     d2    s  500Meg
Rd03     d1    d  1k

Rmet      s    s0 {Rm}

G_TH      0   Tj  VALUE =
+{LIMIT(I(V_sense2)*V(d1,s)+(V(s,s0)**2)/Rm+(I(V_sense)-I(V_sense2))*V(d1,d)+
+(I(V_sense)-I(V_sense2)-I(E_Edg)-I(E_Eds))*V(d,s),-10k,100k)}

.ENDS
*$
.SUBCKT S3_25_m_var1 dd g s0 Tj PARAMS: a=1 dVth=0 dR=0 dgfs=0 Inn=1 Unn=1 Rmax=1
+mos_gmin=1 Rs=1 Rp=1 dC=0 Rm=1u

.PARAM  Fm=0.12      Fn=0.5
.PARAM  c=1.2        Vth0=2.55   auth=3.3m       
.PARAM  UT=100m      ab=22.7m    lB=-23       UB=27
  
.PARAM  b0=49.7      p0=8.7888   p1=-31.4m    p2=45u

.PARAM  Rd=8.7m      nmu=3.5     Tref=298     T0=273       lnIsj=-28.44
.PARAM  ndi=1        Rdi=3.6m    nmu2=0.5     ta=3n        td=20n
.PARAM  Rf=0.7       nmu3=1.6

.PARAM  f1=293p      f2=479p     f3=540p      U0=2.8       nc=0.5  
.PARAM  g1=10        bb=0.3
.PARAM  kbq=85.8u

.PARAM  Vmin=2.1     Vmax=2.9    dCmax=0.33
.PARAM  Vth={Vth0+(Vmax-Vth0)*limit(dVth,0,1)-(Vmin-Vth0)*limit(dVth,-1,0)}
.PARAM  q0={b0*((T0/Tref)**nmu3)*a}
.PARAM  q1={(Unn-Inn*Rs-Vth0)*q0}
.PARAM  q2={(Fm*SQRT(0.4)-c)*Inn*q0}
.PARAM  Rlim={(q1+2*q2*Rmax-SQRT(q1**2+4*q2))/(2*q2)}
.PARAM  dRd={Rd/a+if(dVth==0,limit(dR,0,1)*max(Rlim-Rd/a-Rs-Rp,0),0)}
.PARAM  bm={c/((1/mos_gmin-Rs)**2*Inn*a*(T0/Tref)**nmu3)}
.PARAM  bet={b0+(b0-bm)*if(dR==0,if(dVth==0,limit(dgfs,-1,0),0),0)}
.PARAM  dC1={1+dCmax*limit(dC,0,1)}
.PARAM  dC2={1+1.5*dCmax*limit(dC,0,1)}

.PARAM  Cox={f1*a*dC2}
.PARAM  Cds0={f2*a*dC1}
.PARAM  Cgs0={f3*a*dC1}
.PARAM  dRdi={Rdi/a}

.FUNC  I0(Uee,p,pp,z1)  {if(Uee>pp,(Uee-c*z1)*z1,p*(pp-p)/c*exp((Uee-pp)/p))}
.FUNC  Ig(Uds,T,p,Uee)  {bet*(T0/T)**nmu3*I0(Uee,p,min(2*p,p+c*Uds),min(Uds,Uee/(2*c)))}
.FUNC  J(d,g,T,da) 
+ {a*(sgn(d)*Ig(da,T,(p0+(p1+p2*T)*T)*kbq*T,g-Vth+auth*(T-Tref)+Fm*da**Fn+1*limit(-d,0,1)))}

E_Edg     d   ox  VALUE {max(V(d,g),-bb)-(1/(g1*(1-nc))*((1/(1+g1*max(V(d,g)+bb,0)))**(nc-1)-(1/(1+g1*bb))**(nc-1)))}
C_Cdg    ox    g  {Cox}

Dbody s dd dbody
.model dbody D (BV= {UB},CJO ={Cds0},TT ={ta},IS ={a*exp(lnIsj)} m={0.3} RS={dRdi} )

C_Cgs   g    s   {Cgs0}

G_chan    d    s  VALUE={J(V(d,s),V(g,s),T0+limit(V(Tj),-200,300),abs(V(d,s)))}
G_RMos   dd    d  VALUE={V(dd,d)/(Rf*dRd+(1-Rf)*dRd*((limit(V(Tj),-200,999)+T0)/Tref)**nmu)}

R1        g    s  1G
Rd01      d    s  500Meg
Rd03     dd    d  1k
Rd04     g     d  500Meg

Rmet      s    s0 {Rm}  TC=4m

Rx Tj 0 1k

.ENDS
*$
.SUBCKT IPB03N03LA drain gate source Tj Tcase PARAMS: dVth=0 dRdson=0 dgfs=0 dC=0 Zthtype=0 Ls=0 Ld=0 Lg=0

.PARAM Rs=866u      Rg=0.9       Rd=50u       Rm=190u
.PARAM Inn=55       Unn=4.5      Rmax=4.1m    mos_gmin=56
.PARAM RRf=406m     Rrbond=35m   Rtb=9.3      g2=711m
.PARAM act=10.14

.FUNC   Pb(I,dT,Rb)  {Rb/(2*Rtb)*(I-limit(dT/(max(I,1n)*Rb)+RRf*I*g2,0,I))**2}

X1  d1 g s Tj S3_25_m_var PARAMS: a={act} dVth={dVth} dR={dRdson} dgfs={dgfs} Inn={Inn} Unn={Unn} 
                                        +Rmax={Rmax} mos_gmin={mos_gmin} Rs={Rs} Rp={Rd} dC={dC} Rm={Rm} 
Rg    g1     g    {Rg}   
Lg    gate   g1   {Lg*if(dgfs==99,0,1)}
Gs    s1     s    VALUE={V(s1,s)/(Rs*(1+(limit(V(Tj),-200,999)-25)*4m)-Rm)}
Rsa   s1     s    1Meg
Ls    source s1   {Ls*if(dgfs==99,0,1)}
Rda   d1     d2   {Rd}
Ld    drain  d2   {Ld*if(dgfs==99,0,1)}
Rsb   source s1    10
Rga   gate   g1    10
Rdb   drain  d2    10

G_TH  0    Tb  VALUE =  {Pb(abs(I(Ls)),V(Tj,Tcase),Rrbond*(1+(limit((V(Tb)+V(Tj))/2,-200,999)-25)*4m))}
Cthb  Tb      0               6.24m
Rthb  Tb      Tj              {Rtb} 
Rth1  Tj      t1              {2.6m+limit(Zthtype,0,1)*955.94u}
Rth2  t1      t2              {34.87m+limit(Zthtype,0,1)*12.91m}
Rth3  t2      t3              {128.72m+limit(Zthtype,0,1)*43.11m}

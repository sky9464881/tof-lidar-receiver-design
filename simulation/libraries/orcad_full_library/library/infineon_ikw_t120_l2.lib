.SUBCKT IKW08T120_L2 ano gate kat PARAMS:	TJ = 27
* 
LANO	ano	anol		5n
RLAN	ano	anol		1
LKAT	katl	kat		7n	
RLK	katl	kat		1
XL76xxA anol	gate	katl	L76xxA-L2	PARAMS:  TJ = {TJ} Atotal = 0.124	A = 0.069 Rg = 1m
XDIO	kat	anol		L4XXX_ET	PARAMS:  TJ = {TJ} A=0.0473	N_ideal = 1.05
.ENDS
*$
.SUBCKT IKW15T120_L2  ano gate kat PARAMS:	TJ = 27
*
LANO	ano	anol		5n
RLAN	ano	anol		1
LKAT	katl	kat		7n	
RLK	katl	kat		1
XL76xxA anol	gate	katl	L76xxA-L2 	PARAMS:   TJ = {TJ} Atotal = 0.197	A = 0.128  Rg = 1m
XDIO	kat	anol		L4XXX_ET	PARAMS:	  TJ = {TJ} A=0.065	N_ideal = 1.05
.ENDS
*$
.SUBCKT IKW25T120_L2 ano gate kat PARAMS:	TJ = 27
* 
LANO	ano	anol		5n
RLAN	ano	anol		1
LKAT	katl	kat		7n	
RLK	katl	kat		1
XL76xxA anol	gate	katl	L76xxA-L2 	PARAMS: TJ = {TJ}  Atotal = 0.316	A = 0.215  Rg = 8
XDIO	kat	anol		L4XXX_ET	PARAMS: TJ = {TJ}  A=0.098	N_ideal = 1.05

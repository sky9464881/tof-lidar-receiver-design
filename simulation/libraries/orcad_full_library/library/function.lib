* Fixed PCR-800550: modified this file for Reserved Keywords, ramant
* Revision History : Modified FLYWHEEL model as per CCMPR00197725
* and to fix the DC Motor issue reported in CCMPR00282654. 
*$
*MODEL TYPE : 703
*DEVICE TYPE : Freq Divider
*NAME : DIV_BY_2
*PORT ORDER        A   B  C
.subckt awbdivby2 CLK CLR Q 
+	optional: DPWR=$G_DPWR DGND=$G_DGND
+	params: MNTYMXDLY=0 IO_LEVEL=0
UB inv DPWR DGND
+	CLR   CLRBAR 
+	D0_GATE IO_STD IO_LEVEL={IO_LEVEL} 
UIBUF bufa(2) DPWR DGND
+	$D_HI CLRBAR   PREBAR_BUF CLRBAR_BUF 
+	D0_GATE IO_STD IO_LEVEL={IO_LEVEL} 
UA inv DPWR DGND
+	CLK   CLKBAR 
+	D0_GATE IO_STD IO_LEVEL={IO_LEVEL} 
U1 jkff(1) DPWR DGND
+	PREBAR_BUF CLRBAR_BUF CLKBAR   $D_HI $D_HI   QI $D_NC 
+	D_111_1 IO_STD MNTYMXDLY={MNTYMXDLY} 
U2 dltch(1) DPWR DGND
+	PREBAR_BUF CLRBAR_BUF CLK   QI   Q QBAR 
+	D_111_2 IO_STD MNTYMXDLY={MNTYMXDLY} IO_LEVEL={IO_LEVEL} 
R1 Qbar 0 200Meg
.ends awbdivby2
*$
*MODEL TYPE : 703
*DEVICE TYPE : Freq Divider
*NAME : DIV_BY_4
*PORT ORDER        A   B  C
.subckt awbdivby4 CLK CLR Q 
+	optional: DPWR=$G_DPWR DGND=$G_DGND
+	params: MNTYMXDLY=0 IO_LEVEL=0
xinstFF1 CLK CLR Inter awbdivby2  ;call for model awbdivby2
xinstFF2 Inter CLR Q awbdivby2    ;call for model awbdivby2
.ends awbdivby4
*$
*MODEL TYPE : 43
*DEVICE TYPE : Differentiator
*NAME : DXDT
*PORT ORDER     A   B
.SUBCKT awbdxdt 6   2 
+params: gain = 10
EDUMMY AWBDXDT_DUMMY 0 VALUE={1} ERROR={ERROR (GAIN==0.0, "ZERO VALUED COMPONENT")}
CC1 8 0 {GAIN}
EV1 2 0 4 0 1
RR3 0 2 1.000000K TC=0 0
RR2 0 4 100.000000MEG TC=0 0
RR1 0 8 10.000000G TC=0 0
GI2 0 4 POLY(2) 6 0 8 0 0 1 -10.000000m 0 0 0 0 0 0 0
GI1 0 8 4 0 100
.ENDS awbdxdt
*$
*MODEL TYPE : 420
*DEVICE TYPE : Integrator
*NAME : Integrator2
*PORT ORDER	        A  C  B
.SUBCKT awbintegrator2  1  2  5
+params: gain = 1
EDUMMY AWBINT_DUMMY 0 VALUE={1} ERROR={ERROR (GAIN==0.0, "ZERO VALUED COMPONENT")}
RIN1 1 4 2
RIN2 1 4 2
G1   2 0 4 0 {-GAIN}
R1   2 0 1000000000000
C1   2 0 1
EV1 5 0 2 0 1
ROUT1 5 0 1e3
.ENDS awbintegrator2
*$
*MODEL TYPE : 107
*DEVICE TYPE : Divider
*NAME : DIVIDER2
*PORT ORDER         IN1 IN2 OUT
.SUBCKT awbdivider2 10   8   3 
GI1 0 1 10 0 100
RR3 0 1 100.0MEG TC=0 0
GI3 1 0 POLY(2) 1 0 8 0 0 0 0 0 100 0 0 0 0 0
EV1 3 0 1 0 1
RR1 0 3 1.0K TC=0 0
.ENDS awbdivider2
*$
**MODEL TYPE : 703
*DEVICE TYPE : Freq Divider
*NAME : DIV_BY_3
*PORT ORDER        A   B  C
.subckt awbdivby3 CLK CLR Q 
+ optional: DPWR=$G_DPWR DGND=$G_DGND
+ params: MNTYMXDLY=0 IO_LEVEL=0
X1 CLKBAR $D_HI CLRBAR $D_HI B Q $D_NC $G_DPWR $G_DGND jkff_div
+  PARAMS:IO_LEVEL=0 MNTYMXDLY=0
X2   CLKBAR $D_HI CLRBAR Q B B $D_NC $G_DPWR $G_DGND jkff_div 
+ PARAMS:IO_LEVEL=0 MNTYMXDLY=0
X3  CLK CLKBAR $G_DPWR $G_DGND 7404 
+ PARAMS:IO_LEVEL=0 MNTYMXDLY=0
X4 CLR CLRBAR $G_DPWR $G_DGND 7404 
+ PARAMS:IO_LEVEL=0 MNTYMXDLY=0
.ends awbdivby3
*$
*MODEL TYPE : 703
*DEVICE TYPE : Freq Divider
*NAME : DIV_BY_5
*PORT ORDER        A   B  C
.subckt awbdivby5 CLK CLR Q 
+ optional: DPWR=$G_DPWR DGND=$G_DGND
+ params: MNTYMXDLY=0 IO_LEVEL=0
X1 J1 QB1 K2 $G_DPWR $G_DGND 7408 PARAMS:
+ IO_LEVEL=0 MNTYMXDLY=0
U3 inva(2) DPWR DGND
+	CLK CLR  CLKBAR CLRBAR
+	D0_GATE IO_STD 
X2  CLKBAR $D_HI CLRBAR Q $D_HI Q0 J1 $G_DPWR $G_DGND jkff_div PARAMS:
+ IO_LEVEL=0 MNTYMXDLY=0
X3  CLKBAR $D_HI CLRBAR J1 Q Q1 QB1 $G_DPWR $G_DGND jkff_div PARAMS:
+ IO_LEVEL=0 MNTYMXDLY=0
X4 CLKBAR $D_HI CLRBAR J1 K2 Q QB2 $G_DPWR $G_DGND jkff_div PARAMS:
+ IO_LEVEL=0 MNTYMXDLY=0
.ends awbdivby5
*$
**************************
* jkff_div  Dual J-K Flip-Flops with Preset and Clear    
.subckt jkff_div  CLK PREBAR CLRBAR J K Q QBAR
+	optional: DPWR=$G_DPWR DGND=$G_DGND
+	params: MNTYMXDLY=0 IO_LEVEL=0
* --NOTE--
* The standard Flip-Flops are pulse triggered
*
*
UIBUF bufa(4) DPWR DGND
+	PREBAR CLRBAR J K   PREBAR_BUF CLRBAR_BUF J_BUF K_BUF 
+	D0_GATE IO_STD IO_LEVEL={IO_LEVEL} 
U1 srff(1) DPWR DGND
+	PREBAR_BUF CLRBAR_BUF CLK_BUF   W1 W2   Y YB 
+	D_76_1 IO_STD MNTYMXDLY={MNTYMXDLY} 
U2 srff(1) DPWR DGND
+	PREBAR_BUF CLRBAR_BUF CLKBAR   Y YB   Q2 QB2 
+	D_76_2 IO_STD MNTYMXDLY={MNTYMXDLY} 
U2BUF buf DPWR DGND
+	CLK   CLK_BUF 
+	D_76_4 IO_STD MNTYMXDLY={MNTYMXDLY} IO_LEVEL={IO_LEVEL} 
U3 inva(3) DPWR DGND
+	CLK_BUF J_BUF K_BUF   CLKBAR JB KB 
+	D0_GATE IO_STD 
U4 ao(3,2) DPWR DGND
+	J_BUF K_BUF QB2D J_BUF KB $D_HI   W1 
+	D_76_3 IO_STD MNTYMXDLY={MNTYMXDLY} 
U5 ao(3,2) DPWR DGND
+	J_BUF K_BUF Q2D JB K_BUF $D_HI   W2 
+	D_76_3 IO_STD MNTYMXDLY={MNTYMXDLY} 
UBUF bufa(2) DPWR DGND
+	Q2 QB2   Q2D QB2D 
+	D_76_3 IO_STD MNTYMXDLY={MNTYMXDLY} 
UOBUF bufa(2) DPWR DGND
+	Q2 QB2   Q QBAR 
+	D_76_3 IO_STD MNTYMXDLY={MNTYMXDLY} IO_LEVEL={IO_LEVEL} 
.ends
*$
*-------------------------------------------------------------
*Fuction Library Reopen from 01/072003
* MODEL_TYPE=143
* SYMBOL_NAME=DELAY
* TERM(A)=2 -- IN
* TERM(B)=1 -- OUT
.subckt awbdelay 2 1 PARAMS: DELAY = 10m
EDUMMY AWBDELAY_DUMMY 0 VALUE={1} ERROR={ERROR (DELAY<=0.0, "DELAY MUST BE GREATER THAN ZERO")}
RR2 0 3 1 TC=0 0
GV3 0 3 2 0 2
TT1 3 0 1 0 Z0=1 TD={DELAY}
RR3 0 1 1 TC=0 0
.ends awbdelay
*$
* MODEL_TYPE=143
* SYMBOL_NAME=DELAY1
* TERM(A)=2 -- IN
* TERM(B)=5 -- OUT
.subckt awbdelay1 2 5 PARAMS: DELAY = 10m
EDUMMY AWBDELAY1_DUMMY 0 VALUE={1} ERROR={ERROR (DELAY<=0.0, "DELAY MUST BE GREATER THAN ZERO")}
RR5 0 1 1 TC=0 0
TT2 1 0 5 0 Z0=1 TD={DELAY}
RR4 0 5 1 TC=0 0
*II1 0 1 2
GV3 0 1 2 0 -2
.ends awbdelay1
*$
* MODEL_TYPE=140
* SYMBOL_NAME=IN
* TERM(A)=1 -- PIN
* TERM(B)=2 -- NIN
* TERM(C)=3 -- OUT
.subckt awbin 1 2 3 PARAMS: THR = 10m HYS = 1N
II2 0 3 1u
SS3 3 0 1 2 MS1MSS3
.MODEL MS1MSS3 vswitch VT = {THR} VH = {HYS} RON=1MEG ROFF=1
.ends awbin
*$
*MODEL_TYPE=151
*SYMBOL_NAME=slewlimit
*TERM(A)=1 -- IN
*TERM(B)=7 -- OUT
.subckt awbslew_limit 1 7 PARAMS: POS_SLEW = 1K NEG_SLEW= 1K
.PARAM P = {POS_SLEW}; *scalar(|SRP_scalar|) is neglected
.PARAM Q = {NEG_SLEW}; *scalar(|SRN_scalar|)) is neglected
.PARAM IP = {P*1E-6}
.PARAM IN = {ABS(Q)*1E-6}
***** Slew_Limit -- START OF DECK****
II3 2 4 {IN}
DD5 4 2 M1MIDEALDIODE
.MODEL M1MIDEALDIODE D XTI=0 EG=0
* spectre: + IMAX=1000
DD3 4 3 M1MIDEALDIODE
II1 3 4 {IP}
EV1 3 0 1 0 10K
CC3 2 0 100p
EV15 7 0 2 0 100u
RR4 0 7 1K
.ends awbslew_limit
*$
* MODEL_TYPE=144
* SYMBOL_NAME = ONE_SHOT
* TERM(A)=1 -- TRIGGER
* TERM(B)=11 -- RESET
* TERM(C)=8 -- OUT
.SUBCKT AWBONE_SHOT 1 11 8 PARAMS: DELAY= 1U
.PARAM CC={0.002*DELAY}
EDUMMY AWBONE_SHOT_DUMMY 0 VALUE ={1} ERROR={ERROR(DELAY <= 0,"DELAY MUST BE GREATER THAN ZERO")}
SS10 9 0 8 0 MS1MSS10 
.MODEL MS1MSS10 VSWITCH VT=499.999970M VH=1N RON=1G ROFF=1M
II8 0 9 1.000000M
CC1 9 0 {CC}
SS9 5 4 11 0 MS2MSS9 
.MODEL MS2MSS9 VSWITCH VT=499.999970M VH=1N RON=1 ROFF=1MEG
SS8 5 4 9 0 MS2MSS9
II7 0 4 -2U
VV3 5 0 1
II6 0 2 2U
SS7 0 2 4 0 MS2MSS9
SS6 0 2 1 0 MS2MSS9
II5 0 7 1U
SS5 0 7 4 2 MS3MSS5
.MODEL MS3MSS5 VSWITCH VT=0 VH=499.999970M RON=1 ROFF=1MEG
GV2 0 6 7 0 2U
SS4 6 0 2 0 MS4MSS4
.MODEL MS4MSS4 VSWITCH VT=499.999970M VH=1.000000N RON=1K ROFF=1MEG
II4 6 0 1U
II3 0 8 1U
SS3 8 0 6 0 MS5MSS3
.MODEL MS5MSS3 VSWITCH VT=0 VH=499.999970M RON=1MEG ROFF=1
GV1 0 3 0 0 -2U
SS1 3 0 1 0 MS4MSS4
II1 3 0 -1U
II2 0 7 1U
SS2 7 0 3 0 MS5MSS3
.ENDS AWBONE_SHOT
*$
* MODEL_TYPE=145
* SYMBOL_NAME =VCO
*  TERM(A)=5-IN1
*  TERM(B)=4--IN2
*  TERM(C)=3--OUT
.SUBCKT AWBVCO 5 4 3  PARAMS:AF=1K AV=0.5 BF=900 BV=1
.PARAM ER1={IF(AF<=0,1,(IF(AF==1,1,0)))}
.PARAM II={((bv-av*bf/af)/((bv-av)*1e6))}
.PARAM G={((bf/af-1)/((bv-av)*1e6))}
.PARAM CAP ={1/(AF*4e6)}
EDUMMY1 AWBVCO_DUMMY1 0 VALUE ={1} ERROR={ERROR(ER1 == 1,"A FREQUENCY MUST BE GREATER THAN ZERO BUT NOT EQUAL TO 1")}
EDUMMY2 AWBVCO_DUMMY2 0 VALUE ={1} ERROR={ERROR(BF == 0,"B FREQUENCY MUST BE GREATER THAN ZERO")}
EDUMMY3 AWBVCO_DUMMY3 0 VALUE ={1} ERROR={ERROR(BV == AV,"A VOLTAGE MUST NOT EQUAL B VOLTAGE")}
RR2 4 6 1MEG 
II7 4 6 {II}
GV4 4 6 5 4  {G }
CC1 1 2  {CAP }   IC=-499.999970m
VV2 2 0 499.999970m
GI2 2 1 POLY(2) 6 4 3 2 0 0 0 0 1u 0 0 0 0 0
SS1 3 0 1 2 MS1MSS1
.MODEL MS1MSS1 VSWITCH VT=0 VH=0.5 RON=1 ROFF=1MEG
II1 0 3 1.000000u
.ENDS  AWBVCO
*$
* MODEL_TYPE=134
* SYMBOL_NAME = FY1
* TERM(A)=2 --IN
* TERM(B)=6  --OUT
.SUBCKT AWBFY1 2 6  Params: A0=0 B0=0 B1=0
.PARAM  A11={-A0}
.PARAM  BB1 ={B0-A0*B1}
GI22 0 1 value={ V(2,0)*BB1}
GI13 0 1 VALUE={V(1,0)*A11+V(3,0)}
EV1 6 0 VALUE={V(1,0)+V(2,0)*B1}
RR24 0 6 1G 
CC2 3 0 1
RR2 0 3 1MEG
RR1 0 1 1MEG
CC1 1 0 1

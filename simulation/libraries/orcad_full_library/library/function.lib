*$
* MODEL_TYPE=124
* SYMBOL_NAME = FY3
* TERM(A)=2 --IN
* TERM(B)=6 --OUT
.SUBCKT AWBFY3 2 6  Params: A0=0 B0=0 A1=0 B1=0 A2=0 B2=0 B3=0
.PARAM A11={-A2}
.PARAM A21={-A1}
.PARAM A31={-A0}
.PARAM BB1={B2-A2*B3}
.PARAM BB2={B1-A1*B3}
.PARAM  BB3={B0-A0*B3}
GI22 0 1  VALUE={V(2,0)*BB1}
GI13 0 1  VALUE={V(1,0)*A11+V(3,0)}
GI23 0 3  VALUE={V(2,0)*BB2}
GI4  0 3   VALUE={A21*V(1,0)}
GI5  0 3 VALUE={V(4,0)}
GI24 0 4 VALUE={V(2,0)*BB3}
GI7  0 4 VALUE={V(1,0)*A31}
EV1 6 0 VALUE={V(1,0)+V(2,0)*B3}

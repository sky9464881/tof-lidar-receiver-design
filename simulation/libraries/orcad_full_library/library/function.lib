*$
* MODEL_TYPE=130
* SYMBOL_NAME=Ilim
.subckt AWBILIMIT 5 1 params: RS = 1m IL = -1 IU = 1
.param N = {IL}
.param P = {IU}
.param R = {RS*0.25}
.param PT = {P*R+1}
.param PH = {P*R*0.001}
.param NT = {N*R+1}
.param NH = {ABS(N)*R*0.001}
EDUMMY AWBILIM_NODE1 0 VALUE {1} ERROR={ERROR({P}<={N}, "IU MUST BE GREATER THAN IL")}
VV2 10 4 1
RR3 4 8 {R}
RR4 10 1 10G
II2 8 1 {N}
SS2 8 1 10 1 MS1MSS2
.MODEL MS1MSS2 VSWITCH VT={NT} VH={NH} RON={R} ROFF=1G
VV1 9 5 1
RR1 5 7 {R}
RR2 9 4 10G
II1 7 4 {P}
SS1 7 4 9 4 MS2MSS1
.MODEL MS2MSS1 VSWITCH VT={PT} VH={PH} RON=1G ROFF={R}
.ENDS AWBILIMIT
*$
* MODEL_TYPE=120
* SYMBOL_NAME=COMPLEX_POLE REAL AND IMAG
* TERM(A)=1 - IN
* TERM(B)=2 - OUT
.SUBCKT AWBCMPLXRI 1 2 PARAMS: HP_GAIN=0 BP_GAIN=0 LP_GAIN=1 REAL_HZ=1 IMAG_HZ=1
.PARAM ALFA={REAL_HZ}
.PARAM BETA={IMAG_HZ}
.PARAM mod_pi=3.14159265
.PARAM NAT_FREQ={{ALFA*ALFA + BETA*BETA}^0.5}
.PARAM OMEGA={2*mod_pi*NAT_FREQ}
.PARAM DAMPING={ALFA/NAT_FREQ}
.PARAM L_AND_C={1/OMEGA}
.PARAM R={2*DAMPING + 1E-6}
.PARAM A0={HP_GAIN*OMEGA*OMEGA}
.PARAM A1={{BP_GAIN*OMEGA}/R}
.PARAM A2={LP_GAIN}
.PARAM TMP1={IF(HP_GAIN > BP_GAIN,HP_GAIN,BP_GAIN)}
.PARAM TMP2={IF(TMP1 < LP_GAIN,LP_GAIN,TMP1)}
.PARAM TMP3={1E10/TMP2}
.PARAM BIG_R={IF(TMP3 < 1E8,TMP3,1E8)}
.PARAM MAX_A1={IF(A0 > A1,A0,A1)}
.PARAM MAX_A={IF(MAX_A1 < A2,A2,MAX_A1)}
.PARAM MAX_A_SQRT={MAX_A^0.5}
.PARAM A0_DIV_SQRT={A0/MAX_A_SQRT}
.PARAM A1_DIV_SQRT={A1/MAX_A_SQRT}
.PARAM A2_DIV_SQRT={A2/MAX_A_SQRT}
.PARAM ER1 ={IF({LP_GAIN}==0,IF({HP_GAIN}==0,IF({BP_GAIN}==0,1,0),0),0)}
.PARAM ER2 ={IF({LP_GAIN}<0,1,(IF({BP_GAIN}<0,1,(IF({HP_GAIN}<0,1,0)))))}
RIN1 1 8 2
RIN2 1 8 2
E1   3 0 8 0 {MAX_A_SQRT}
L1   3 4 {L_AND_C}
R1   4 5 {R}
C1   5 0 {L_AND_C}
EHP  2 6 3 4 {A0_DIV_SQRT}
EBP  6 7 4 5 {A1_DIV_SQRT}
ELP  7 0 5 0 {A2_DIV_SQRT}
ROUT 2 0 {BIG_R}
EDUMMY1 AWBCMPLXRI_DUMMY1 0 VALUE ={1} ERROR={ERROR(ER1==1,"ATLEAST ONE GAIN EXPECTED TO BE NON-ZERO")}
EDUMMY2 AWBCMPLXRI_DUMMY2 0 VALUE ={1} ERROR={ERROR(ER2==1,"NEGATIVE VALUED COMPONENT")}
EDUMMY3 AWBCMPLXRI_DUMMY3 0 VALUE ={1} ERROR={ERROR(ALFA<=0,"POLE LOCATION EXPECTED TO BE GREATER THAN ZERO")}
.ENDS AWBCMPLXRI
*$
* MODEL_TYPE=45
* SYMBOL_NAME=COMPLEX_POLE FREQ AND DAMP
* TERM(A)=1 - IN
* TERM(B)=2 - OUT
.SUBCKT AWBCMPLXFZ 1 2 PARAMS: HP_GAIN=0 BP_GAIN=0 LP_GAIN=1 FREQ_HZ=1 DAMPING=1
.PARAM mod_pi=3.14159265
.PARAM NAT_FREQ={FREQ_HZ} 
.PARAM OMEGA={2*mod_pi*NAT_FREQ}
.PARAM L_AND_C={1/OMEGA}
.PARAM R={2*DAMPING}
.PARAM A0={HP_GAIN*OMEGA*OMEGA}
.PARAM A1={{BP_GAIN*OMEGA}/R}
.PARAM A2={LP_GAIN}
.PARAM TMP1={IF(HP_GAIN > BP_GAIN,HP_GAIN,BP_GAIN)}
.PARAM TMP2={IF(TMP1 < LP_GAIN,LP_GAIN,TMP1)}
.PARAM TMP3={1E10/TMP2}
.PARAM BIG_R={IF(TMP3 < 1E8,TMP3,1E8)}
.PARAM MAX_A1={IF(A0 > A1,A0,A1)}
.PARAM MAX_A={IF(MAX_A1 < A2,A2,MAX_A1)}
.PARAM MAX_A_SQRT={MAX_A^0.5}
.PARAM A0_DIV_SQRT={A0/MAX_A_SQRT}
.PARAM A1_DIV_SQRT={A1/MAX_A_SQRT}
.PARAM A2_DIV_SQRT={A2/MAX_A_SQRT}
.PARAM ER ={IF({LP_GAIN}==0,IF({HP_GAIN}==0,IF({BP_GAIN}==0,1,0),0),0)}
RIN1 1 8 2
RIN2 1 8 2
E1   3 0 8 0 {MAX_A_SQRT}
L1   3 4 {L_AND_C}
R1   4 5 {R}
C1   5 0 {L_AND_C}
EHP  2 6 3 4 {A0_DIV_SQRT}
EBP  6 7 4 5 {A1_DIV_SQRT}
ELP  7 0 5 0 {A2_DIV_SQRT}
ROUT 2 0 {BIG_R}
EDUMMY1 AWBCMPLXFZ_DUMMY1 0 VALUE ={1} ERROR={ERROR(ER==1,"ATLEAST ONE GAIN EXPECTED TO BE NON-ZERO")}
.ENDS AWBCMPLXFZ
*$
*MODEL_TYPE=44
*SYMBOL_NAME=REALPOLE2
*TERM(A)=1 -- IN
*TERM(B)=2 -- OUT
.SUBCKT AWBREALPOLE2 1 2
+ PARAMS: GAIN =1 FREQ_HZ = 1K
.PARAM PLOC = {FREQ_HZ}
.PARAM SCALED_GAIN = {GAIN}
.PARAM TMP = {1.0E10/SCALED_GAIN}
.PARAM ENG_BIG_R={IF(TMP<1.0E8,TMP,1.0E8)}
.PARAM mod_pi = {3.1415926535897932384626433832795}
.PARAM ENG_C = {1.0/(200.0*mod_pi*PLOC)}
RIN1 1 4 2
RIN2 1 4 2
G1   3 0 4 0 -0.01
R1   3 0 100
C1   3 0 {ENG_C}
E1   2 0 3 0 {SCALED_GAIN}
ROUT 2 0 {ENG_BIG_R}
EDUMMY1 AWBREALPOLE_DUMMY1 0 VALUE ={1} ERROR={ERROR(PLOC<=0,"POLE LOCATION EXPECTED TO BE GREATER THAN ZERO")}
.ENDS AWBREALPOLE2
*$
*MODEL_TYPE=201
*SYMBOL_NAME=REALZERO2
*TERM(A)=1 -- IN
*TERM(B)=4 -- OUT
.SUBCKT AWBREALZERO2 1 4 PARAMS: FREQ_HZ = 1K GAIN=1
.PARAM ZLOC={FREQ_HZ}
.PARAM SCALED_GAIN={GAIN}
.PARAM SQRTP={SQRT(ABS(SCALED_GAIN))}
.PARAM ENG_P={SQRTP}
.PARAM SQRTN1={SQRTP*ABS(SCALED_GAIN)}
.PARAM SQRTN={1E6*SQRTN1/SCALED_GAIN}
.PARAM ENG_N :={SQRTN}
.PARAM mod_pi = {3.1415926535897932384626433832795}
.PARAM ENG_C= {0.0000005 / (mod_pi*ZLOC)}
R10 1 5 1K
R20 1 5 1K
E1 2 0 5 0 {ENG_P}
R2 2 6 1MEG
C1 2 6 {ENG_C}
R3 6 3 10U
H1 4 0 V1 {ENG_N}
V1 3 0 0.0
ROUT 4 0 1K
.ENDS AWBREALZERO2
*$
*  MODEL_TYPE=122
*  SYMBOL_NAME=fxyzt
* TERM(A)=2
* TERM(B)=3
* TERM(C)=1
.SUBCKT AWBFXYZT 2 3 1 PARAMS: A=0 B=0 C=0 D=0 E=0 F=0  G=0 H=0 I=0 J=0 K=0 L=0 M=0 N=0 O=0 P=0
 GI5 0 1 VALUE={(K*V(5,0))+(L*V(5,0)*V(5,0))+(N*V(5,0)*V(2,0))+(M*(V(5,0)^3))+(O*V(5,0)*V(5,0)*V(2,0))+(P*V(5,0)*V(2,0)*V(2,0))}
RR7 0 5 1G
VD 5 0 PWL (0.0 0.0 1.00e+03  1.0e+03  )
GI4 0 1 VALUE={J*V(1,0)*V(3,0)}
RR6 0 2 1G
RR5 0 3 1G
GI3 0 1 VALUE={G*V(3,0)+H*V(2,0)*V(3,0)+I*V(3,0)*V(3,0)}
GI2 0 1 VALUE={A+B*V(1,0)+C*V(2,0)+D*V(1,0)*V(1,0)+E*V(1,0)*V(2,0)+F*V(2,0)*V(2,0)}
CC2 1 0 1
RR2 0 1 1MEG
.ENDS AWBFXYZT
*$
*   MODEL_TYPE=135
*   SYMBOL_NAME=DCMOTOR
* TERM(A)=4 
* TERM(B)=7
* TERM(C)=3
.SUBCKT AWBDCMOTOR  4 7 3 PARAMS: R=0 L=1M BACK_EMF=1 K_TORQ=1 K_VISC=0 INERTIA=1M CONST_FRIC=0
.PARAM LA = {L}
.PARAM RL = {R*1E6+1E3}
.PARAM KE = {BACK_EMF}
.PARAM KT = {K_TORQ/RA}
.PARAM JM = {INERTIA}
.PARAM RF = {1/(K_VISC+1E-12)}
.PARAM TF = {CONST_FRIC}
.PARAM RA = {R+1E-6}
EDUMMY1 AWBDCMOTOR_DUMMY1 0 VALUE ={1} ERROR={ERROR(INERTIA == 0,"ROTOR INERTIA MUST BE NONZERO")}
EDUMMY2 AWBDCMOTOR_DUMMY2 0 VALUE ={1} ERROR={ERROR(L == 0,"ARMATURE INDUCTANCE MUST BE NONZERO")}
II2 3 0 {TF}
RR3 0 3 {RF}
CC1 3 0 {JM}
GI1 0 3 4 2 {KT}
EV1 1 7 3 0 {KE}
RR2 4 2 {RA}
RR1 2 1 {RL}
LL1 2 1 {LA}
.ENDS AWBDCMOTOR
*$

EDUMMY2 AWBTACHO_DUMMY2 0 VALUE ={1} ERROR={ERROR(L == 0,"ARMATURE INDUCTANCE MUST BE NONZERO")}
II2 3 0 {TF}
RR3 0 3 {RF}
CC1 3 0 {JM}
RR10 7 4 1.0G
GI1 0 3 4 2 {KT}
EV1 1 7 3 0 {KE}
RR2 4 2 {RA}
RR1 2 1 {RL}
LL1 2 1 {LA}
.ENDS AWBTACHO

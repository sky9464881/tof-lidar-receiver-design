*$
* MODEL_TYPE=141
* SYMBOL_NAME=OUT
* TERM(A)=2 - IN
* TERM(B)=1 - REF
* TERM(C)=3 - OUT
.subckt awbout 2 1 3 params: ROUT = 1 VLO = 0 VHI = 1
.param HI = {VHI}
.param LO = {VLO}
.param GG = {(HI-LO)/ROUT}
.param II = {(LO)/ROUT}

.SUBCKT SPD01N60S5 drain gate source Tj Tcase PARAMS: dVth=0 dRdson=0 Zthtype=0 
 
.PARAM Ls=7n       Lg=7n       Ld=1n       Rs=3m       Rg=8         
.PARAM act=0.5925  Inn=500m    Unn=10      Rmax=6       
.PARAM lzth={limit(Zthtype,0,1)} 
 
X1  dd g s Tj 1 cool_600_c_var PARAMS: act={act} dVth={dVth} dR={dRdson} Inn={Inn} Unn={Unn}  
                                        +Rmax={Rmax} Rs={Rs} heat=1 
 
L_Ld         drain  dd    {Ld} 
R_Ld         drain  dd    10 
 
L_Ls         source lsrs  {Ls} 
R_Ls         source lsrs  10 
R_Rs         s      lsrs  {Rs} 
 
L_Lg         gate   lgrg  {Lg} 
R_Lg         gate   lgrg  10 
R_Rg         lgrg   g     {Rg} 
 
C_CZth1      Tj     0     5.7u 
C_CZth2      0      1     34.371u 
C_CZth3      0      2     48.524u 
C_CZth4      0      3     500u 
C_CZth5      0      4     1m 
C_CZth6      0      Tcase 42.5m 
C_CZth7      0      6     65m 
C_CZth8      0      7     90m 
R_Rth1       Tj     1     {229.32m+lzth*131.13m} 
R_Rth2       1      2     {316.31m+lzth*180.87m} 
R_Rth3       2      3     {1.78+lzth*1.02} 
R_Rth4       3      4     {785.59m+lzth*2.54} 
R_Rth5       4      Tcase {674.69m+lzth*2.35} 
R_Rth6       Tcase  6     500m 
R_Rth7       6      7     50 
.ENDS 
*$ 

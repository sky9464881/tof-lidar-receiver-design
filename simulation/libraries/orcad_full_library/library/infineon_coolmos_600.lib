.PARAM act=0.5925  Inn=200m    Unn=10      Rmax=6       
.PARAM lzth={limit(Zthtype,0,1)} 
 
X1  dd g s Tj 1 cool_600_c_var PARAMS: act={act} dVth={dVth} dR={dRdson} Inn={Inn} Unn={Unn}  
                                        +Rmax={Rmax} Rs={Rs} heat=1 
 

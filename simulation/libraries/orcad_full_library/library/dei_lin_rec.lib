*$
.subckt sn75als192 A G Gbar Y Z 
+	optional: DPWR=$G_DPWR DGND=$G_DGND
+	params: MNTYMXDLY=0 IO_LEVEL=0
U_inv1 inv DPWR DGND
+	gbar   gbarbar 
+	D_04XX IO_STD_sn75als192 MNTYMXDLY={MNTYMXDLY} IO_LEVEL={IO_LEVEL} 
U_or2 OR(2)
+  DPWR  DGND
+  G gbarbar  sel
+	D_04XX IO_STD_sn75als192 MNTYMXDLY={MNTYMXDLY} IO_LEVEL={IO_LEVEL} 
U_bufA BUF3
+  DPWR  DGND
+  A SEL  Y
+  D_XX IO_STD_sn75als192 MNTYMXDLY={MNTYMXDLY} IO_LEVEL={IO_LEVEL} 
U_invZ INV3
+  DPWR  DGND
+  A SEL  Z
+  D_XX IO_STD_sn75als192 MNTYMXDLY={MNTYMXDLY} IO_LEVEL={IO_LEVEL} 
.model D_xx utgate (
+	tplhty=8ns	tplhmx=13ns
+	tphlty=12ns	tphlmx=18ns
+	tpzhty=11ns	tpzhmx=17ns
+	tpzlty=16ns	tpzlmx=25ns
+	tphzty=5ns	tphzmx=8ns
+	tplzty=7ns	tplzmx=12ns
+	)
.model D_04XX ugate (
+	tplhty=12ns	tplhmx=22ns
+	tphlty=8ns	tphlmx=15ns
+	)
.model IO_STD_sn75als192 uio (
+	drvh=96.4	drvl=104
+	AtoD1="AtoD_STD"	AtoD2="AtoD_STD_NX"
+	AtoD3="AtoD_STD"	AtoD4="AtoD_STD_NX"
+	DtoA1="DtoA_STD"	DtoA2="DtoA_STD"
+	DtoA3="DtoA_STD"	DtoA4="DtoA_STD"
+       tswhl1=1.511ns		tswlh1=3.517ns
+       tswhl2=1.487ns		tswlh2=3.564ns
+       tswhl3=1.511ns		tswlh3=3.517ns
+       tswhl4=1.487ns		tswlh4=3.564ns
+	DIGPOWER="DIGIFPWR" )
.ends sn75als192
*$

*$
.subckt sn75als193 A B G Gbar Y 
+	optional: DPWR=$G_DPWR DGND=$G_DGND
+	params: MNTYMXDLY=0 IO_LEVEL=0
U_inv1 inv DPWR DGND
+	gbar   gbarbar 
+	D_04XX IO_STD MNTYMXDLY={MNTYMXDLY} IO_LEVEL={IO_LEVEL} 
U_or2 OR(2)
+  DPWR  DGND G gbarbar  sel
+	D_04XX IO_STD MNTYMXDLY={MNTYMXDLY} IO_LEVEL={IO_LEVEL} 
U1 buf DPWR DGND a_bdiff  node1 
+	D_04XX IO_STD MNTYMXDLY={MNTYMXDLY} IO_LEVEL={IO_LEVEL} 
Ediff node1 0 value { IF (V(a,b) >=0.2,5.0,IF(V(a,b) < 0.2 & V(a,b) > -0.2,1.4,IF(V(a,b) <= -0.2,0.0,0.001)))} 
Ubuf3 buf3 $G_DPWR $G_DGND
+	node1   sel   Y 
+	D_426 IO_STD MNTYMXDLY={MNTYMXDLY} IO_LEVEL={IO_LEVEL} 
.model D_04XX ugate (
+	tplhty=12ns	tplhmx=22ns
+	tphlty=8ns	tphlmx=15ns)
.ends sn75als193
*$

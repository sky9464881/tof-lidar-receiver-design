.SUBCKT DEI1047 IN1A IN1B 
+IN2A IN2B 
+IN3A IN3B 
+IN4A IN4B 
+IN5A IN5B 
+IN6A IN6B 
+IN7A IN7B 
+IN8A IN8B 
+TESTA TESTB 
+OUT1A OUT1B  
+OUT2A OUT2B 
+OUT3A OUT3B 
+OUT4A OUT4B 
+OUT5A OUT5B 
+OUT6A OUT6B 
+OUT7A OUT7B 
+OUT8A OUT8B
+VDD
+VSS1
+VSS
RTESTA TESTA 0 1K
RTESTB TESTA 0 1K

VTESTA TESTA 0 dc 0v    ;TESTA AND TESTB PINS ARE NOT MODELED 
VTESTB TESTB 0 dc 0v

E1A OUT1A 0 VALUE {IF((V(IN1A)-V(IN1B)>=6.5 | (V(TESTA) >=2.5 & V(TESTB) <=0.5) ),5.0,
+IF((V(IN1A)-V(IN1B)<=2.5 | (V(TESTA) <=0.5 & V(TESTB) >=2.5) ), 0.0,0.0))}
ROUT1A OUT1A 0 300K
COUT1A OUT1A 0 1P


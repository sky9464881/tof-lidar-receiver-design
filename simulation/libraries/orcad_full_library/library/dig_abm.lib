.ENDS DFFPC_ABM2
***********************************************************
*POSITIVE EDGE TRIGGERED DFF WITH RESET AND SET
*********************************************************
.SUBCKT DFFRS_ABM D CLK RST SET Q QBAR PARAMS: VIH=1.5 VOH=5.0 VOL=0.0 
E_NOT_ABM1 CLK1 0 VALUE {IF((V(CLK) >= VIH), VOL, VOH)}
E_NOT_ABM2 D1 0 VALUE {IF((V(DIN) >= VIH), VOL, VOH)}
X1 D SET RST DIN SET_RESET_DFFRS PARAMS: VIH={VIH} VOH={VOH} VOL={VOL} 
X2 DIN CLK1 D1 Q1 Q1BAR  DFFRS_ABM1 PARAMS: VIH={VIH} VOH={VOH} VOL={VOL} 
X3 Q1 CLK Q1BAR Q QBAR DFFRS_ABM1 PARAMS: VIH={VIH} VOH={VOH} VOL={VOL} 
.ENDS DFFRS_ABM
*
*PORT_ORDER: 		IN1   SET     RST     OUT    
.SUBCKT SET_RESET_DFFRS 1	2	3	4
+PARAMS: VIH=1.5 VOH=5.0 VOL=0.0 
E_NOT_ABM1 5 0 VALUE {IF((V(3) >= VIH), VOL, VOH)}
E_OR_ABM2 6 0 VALUE {IF(((V(1) < VIH) & ( V(2) < VIH)), VOL, VOH)}
E_AND_ABM3 4 0 VALUE {IF(((V(5)>= VIH) & (V(6)>= VIH)),VOH,VOL)}
.ENDS SET_RESET_DFFRS

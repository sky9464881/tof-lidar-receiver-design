*
*********************************************************
*POSITIVE EDGE TRIGGERED DFF
*********************************************************
.SUBCKT DFF_ABM D CLK Q QBAR PARAMS: VIH=1.5 VOH=5.0 VOL=0.0 
E_NOT_ABM1 CLK1 0 VALUE {IF((V(CLK) >= VIH), VOL, VOH)}
E_NOT_ABM2 D1 0 VALUE {IF((V(D) >= VIH), VOL, VOH)}
X1 D CLK1 D1 Q1 Q1BAR  DFF_ABM1 PARAMS: VIH={VIH} VOH={VOH} VOL={VOL} 
X2 Q1 CLK Q1BAR Q QBAR DFF_ABM1 PARAMS: VIH={VIH} VOH={VOH} VOL={VOL} 
.ENDS DFF_ABM
*
*PORT_ORDER: 	   IN1	CLK	IN2	OUT1	OUT2    
.SUBCKT DFF_ABM1    1	 2	3	4	5
+PARAMS: VIH=1.5 VOH=5.0 VOL=0.0 
E_NAND_ABM1 6 0 VALUE {IF(((V(1)>= VIH) & (V(2)>= VIH)), VOL, VOH)}
E_NAND_ABM2 7 0 VALUE {IF(((V(2)>= VIH) & (V(3)>= VIH)), VOL, VOH)}
E_NAND_ABM3 8 0 VALUE {IF(((V(6)>= VIH) & (V(5)>= VIH)), VOL, VOH)}
E_NAND_ABM4 9 0 VALUE {IF(((V(4)>= VIH) & (V(7)>= VIH)), VOL, VOH)}
RM	8	4	1m
RM1	9	5	1m
CQ	4	0	1u  IC=0.0
RQ	4	0	1meg
CQB	5	0	1u  IC={ VOH }
RQB	5	0	1meg
.ENDS DFF_ABM1
*
*********************************************************
*POSITIVE EDGE TRIGGERED DFF WITH PRESET AND CLEAR
*********************************************************
.SUBCKT DFFPC_ABM D CLK CLR PRE Q QBAR PARAMS: VIH=1.5 VOH=5.0 VOL=0.0 
E_NOT_ABM1 CLK1 0 VALUE {IF((V(CLK) >= VIH), VOL, VOH)}
E_NOT_ABM2 D1 0 VALUE {IF((V(D) >= VIH), VOL, VOH)}
E_NOT_ABM3 PRE1 0 VALUE {IF((V(PRE) >= VIH), VOL, VOH)}
E_NAND_ABM1 CLR1 0 VALUE {IF(((V(PRE1)>= VIH) & (V(CLR)>= VIH)), VOL, VOH)}
X1 D CLK1 D1 PRE1 CLR1 Q1 Q1BAR  DFFPC_ABM1 PARAMS: VIH={VIH} VOH={VOH} VOL={VOL} 
X2 Q1 CLK Q1BAR PRE1 CLR1 Q QBAR DFFPC_ABM2 PARAMS: VIH={VIH} VOH={VOH} VOL={VOL} 
.ENDS DFFPC_ABM
*
*PORT_ORDER: 	   IN1	CLK	IN2	PRE	CLR	OUT1	OUT2    
.SUBCKT DFFPC_ABM1  1	 2	3	4	5	6	7	
+PARAMS: VIH=1.5 VOH=5.0 VOL=0.0 
E_NAND_ABM1 8 0 VALUE {IF(((V(1)>= VIH) & (V(2)>= VIH) & (V(5)>= VIH)), VOL, VOH)}
E_NAND_ABM2 9 0 VALUE {IF(((V(2)>= VIH) & (V(3)>= VIH) & (V(4)>= VIH)), VOL, VOH)}
E_NAND_ABM3 10 0 VALUE {IF(((V(4)>= VIH) & (V(8)>= VIH) & (V(7)>= VIH)), VOL, VOH)}
E_NAND_ABM4 11 0 VALUE {IF(((V(5)>= VIH) & (V(9)>= VIH) & (V(6)>= VIH)), VOL, VOH)}
RM	10	6	1m
RM1	11	7	1m
CQ	6	0	1u  IC=0.0
RQ	6	0	1meg   
CQB	7	0	1u  IC={ VOH }
RQB	7	0	1meg
.ENDS DFFPC_ABM1
*
*PORT_ORDER: 	   IN1	CLK	IN2	PRE	CLR	OUT1	OUT2    
.SUBCKT DFFPC_ABM2  1	 2	3	4	5	6	7
+PARAMS: VIH=1.5 VOH=5.0 VOL=0.0 
E_NAND_ABM1 8 0 VALUE {IF(((V(1)>= VIH) & (V(2)>= VIH)), VOL, VOH)}
E_NAND_ABM2 9 0 VALUE {IF(((V(2)>= VIH) & (V(3)>= VIH)), VOL, VOH)}
E_NAND_ABM3 10 0 VALUE {IF(((V(4)>= VIH) & (V(8)>= VIH) & (V(7)>= VIH)), VOL, VOH)}
E_NAND_ABM4 11 0 VALUE {IF(((V(5)>= VIH) & (V(9)>= VIH) & (V(6)>= VIH)), VOL, VOH)}

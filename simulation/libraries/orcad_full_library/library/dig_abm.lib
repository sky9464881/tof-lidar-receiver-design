E_NAND_ABM4 9 0 VALUE {IF(((V(4)>= VIH) & (V(7)>= VIH)), VOL, VOH)}
RM	8	4	1m
RM1	9	5	1m
CQ	4	0	1u  IC=0.0
RQ	4	0	1meg
CQB	5	0	1u  IC={ VOH }
RQB	5	0	1meg
.ENDS DFFRS_ABM1

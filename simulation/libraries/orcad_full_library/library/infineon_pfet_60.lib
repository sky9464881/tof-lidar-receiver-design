.PARAM  act=2.32

X1  d1 g s Tj P_60lvar PARAMS: a={act} 
Rg    g1     g    {Rg}   
Lg    gate   g1   {Lg}
Gs    s1     s    VALUE={V(s1,s)/(Rs*(1+(limit(V(Tj),-200,999)-25)*0.004))}
Ls    source s1   {Ls}
Rda1  d1     d2   {Rd}
Ld    drain  d2   {Ld}

E1    Tj     w      VALUE={TEMP}
R1    w      0      1u

.ENDS

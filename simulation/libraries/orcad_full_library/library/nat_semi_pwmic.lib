+  v(sync_dominent)>1, 0,-2.65*I(VRT)*4/3/2),if ( v(clk)>2.5 |
+  v(sync_dominent)>1, 0,-3.2*I(VRT)*10/9/2)))) }
Rq7 F5 F6 500  

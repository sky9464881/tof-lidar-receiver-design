+  If(I(VTIME)>0, V(oa), 5-V(oa)),0) }
Csd3 ZSSDISTRIG 0 3E-12 IC=5 
Ecs24 CS27 0 VALUE {
+  IF(IC==0,if(V(CS2INT)>0.25,5,0),if(V(CS2INT)>0.5,5,0)) }
Eoffend1 OFFEND1 0 VALUE { if(V(SYNC_INT)<1,5,0) }
Rvcc7 0 VCC4 5E3  
Cvcc6 VCC4 0 3E-12 IC=0 

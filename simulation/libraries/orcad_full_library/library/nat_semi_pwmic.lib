+|((V(PH)<=(V(dPH)-0.1)) & 
+(V(MskPWM)<=2.5))) | (V(ILIM)>0.5 & V(PH)>2.5),5,0) }
Etc8         TC18 0 VALUE { if(V(comp2pwm)>0 & (V(MskPWM)>2.5 | V(PH)>2.5 ) & (V(delayDRVD)
+>0.5& V(delayDRVD)<=2.5),5,0) }


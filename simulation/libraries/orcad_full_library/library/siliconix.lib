.SUBCKT Si4768CY VDD Clk Gnd Boot D1 S1 D2 S2
*                VDD Clk Gnd Boot D1 S1 D2 S2
* #alias bbm  v(bbm)
* #alias a3o  v(a3o)
* #alias a2o  v(a2o)
* #alias g1  v(g1)
* #alias a1o  v(a1o)
* #alias vboot  v(boot)
* #alias vdduvlo  v(vdduvlo)
* #alias g2  v(g2)

EB1 A2O gnd Value={ IF ( V(VDDUvlo) > 1 & V(16) > 4 & V(G2) < 2 , 5 , 0 ) }
EB5 8 28 Value={ IF ( V(A2O) > 1 , -5 , 5 ) }
R8 11 8 35
C3 G1 11 35p
R3 14 16 275
C1 16 gnd 120p
EB2 In2 gnd Value={ IF ( V(16) > 4 , 5 , 0 ) }
EB9 A3O gnd Value={ IF ( V(VDDUvlo) > 1 & V(A1O) > 1 & V(16) > 1 , 5 , 0 ) }
R2 27 A1O 100
Q2 Boot Boot Vdd D68BootD
.MODEL D68BootD PNP      (
+ IS=5.828556E-18 BF=1.2465499
+ NF     = 0.9018194       BR     = 0.0743382       NR     = 1.0087761
+ ISE    = 3.690477E-15    NE     = 1.0479867
+ ISC    = 5.929013E-14    NC     = 1.47            VAF    = 1E4
+ VAR    = 2E4             IKF    = 10.6793593      IKR    = 100
+ RB     = 130.4148594     RBM    = 0.0957343       IRB    = 9.494516E-6
+ RE     = 1.0245273       RC     = 80              CJE    = 1.45909E-10
+ VJE    = 0.803           MJE    = 0.3267463       FC     = 0.5
+ CJC    = 2.48725E-10     VJC    = 0.6097614       MJC    = 0.3677641
+ TR     = 7.68E-7         XTB    = 3.4
+ EG     = 1.32            XTI    = 0.5
* TRC1   = 3E-3  TRE1   = 1E-3 TNE1   = 4E-5 TLEV   = 2 DCAP=2   ! HSPICE Removed
R1 G2 30 1
EB3 In3 gnd Value={ IF ( V(16) > 2.2 , 5 , 0 ) }
R7 28 G1 0.1
C4 A1O gnd 1n
EB8 27 gnd Value={ IF ( V(VDDUvlo) > 1 & V(BBM) > 1 , 5 , 0 ) }
EBIN 14 gnd Value={ IF ( V(Clk) > 2.3 , 5 , 0 ) }
XS2 25 VDDUvlo Vdd 0 SWhyste PARAMS: VT=3.8 VH=.2 RON=1 ROFF=10meg
V7 25 0 DC=10
R5 VDDUvlo gnd 1
EB7 BBM gnd Value={ IF ( V(S1) < 2.4 , 5 , 0 ) }
EB4 2 G2 Value={ IF ( V(A3O) > 1 , 5 , -5 ) }
R6 12 2 35
C2 12 G2 35p
X2 D1 G1 S1 68HSFET 
X3 D2 30 S2 68LSFET 

M3 28 11 S1 S1 DrivFETNh
.MODEL DrivFETNh NMOS Level=1 CBD=212p CBS=254p CGBO=428n
+ CGDO=260n CGSO=312n GAMMA=0 IS=1.00p KP=1 LAMBDA=2.50m
+ MJ=0.460 PB=0.800 PHI=.75 RD=98.0m RS=98.0m VTO=2
M4 G2 12 gnd gnd DrivFETNL
.MODEL DrivFETNL NMOS Level=1 CBD=127p CBS=153p CGBO=257n
+ CGDO=156n CGSO=187n GAMMA=0 IS=1.00p KP=2 LAMBDA=2.50m
+ MJ=0.460 PB=0.800 PHI=.75 RD=84.0m RS=84.0m VTO=3
V3 Boot 13
M7 28 11 13 13 DrivFETPh2 
.MODEL DrivFETPh2 PMOS Level=1 CBD=212p CBS=254p CGBO=428n
+ CGDO=260n CGSO=312n GAMMA=0 IS=1.00p KP=1 LAMBDA=2.50m
+ MJ=0.460 PB=0.800 PHI=.75 RD=0.112 RS=0.112 VTO=-4
M8 G2 12 Vdd Vdd DrivFETPL2 
.MODEL DrivFETPL2 PMOS Level=1 CBD=127p CBS=153p CGBO=257n
+ CGDO=156n CGSO=187n GAMMA=0 IS=1.00p KP=2 LAMBDA=2.50m
+ MJ=0.460 PB=0.800 PHI=.75 RD=98m RS=98m VTO=-2
.ENDS


*****************************************************************
* INFINEON Power Transistors                                    *
* Level 1/3 PSPICE Library for SFET 100V n-Channel Transistors  *
* Version 230702                                                *
*                                                               *
*****************************************************************
* simulation support:  simulate@infineon.com                    *
*                                                               *
* internet          :  www.infineon.com/simulate                * 
*****************************************************************
*                                                               *
* Models provided by Infineon are not warranted by Infineon as  *
* fully representing all the specifications and operating       *
* characteristics of the semiconductor product to which the     *
* model relates. The models describe the characteristics of     *
* typical devices.                                              *
* In all cases, the current data sheet information for a given  *
* device is the final design guideline and the only actual      *
* performance specification.                                    *
* Although models can be a useful tool in evaluating device     *
* performance, they cannot model exact device performance under *
* all conditions, nor are they intended to replace bread-       *
* boarding for final verification. INFINEON therefore does not  *
* assume any liability arising from their use.                  *
* INFINEON reserves the right to change models without prior    *
* notice.                                                       *
*                                                               *
* This library contains models of the following INFINEON        *
* SFET transistors:                                             *
*                                                               *
*   100V NL                       100V LL                       *
*   SPB10N10                      SPB10N10L                     *
*   SPI10N10                      SPI10N10L                     *
*   SPP10N10                      SPP10N10L                     *
*   SPD11N10                                                    *
*   SPU11N10                                                    *
*   SPB21N10                                                    *
*   SPI21N10                                                    *
*   SPP21N10                                                    *
*   SPB35N10                                                    *
*   SPD35N10                                                    *
*   SPI35N10                                                    *
*   SPP35N10                                                    *
*   SPB47N10                      SPB47N10L                     *
*   SPI47N10                      SPI47N10L                     *
*   SPP47N10                      SPP47N10L                     *
*                                 SPB70N10L                     *
*                                 SPI70N10L                     *
*                                 SPP70N10L                     * 
*                                 SPB80N10L                     *
*                                 SPI78N10L                     *
*                                 SPP80N10L                     *
*                                 SIPC15N10L                    * 
*****************************************************************
* thermal nodes of level 3 models:                              *
*                                                               *
*  .SUBCKT SPI80N08S2-07R drain gate source Tj Tcase            *
*  Tj :    potential=temperature (in °C) at junction (typically *
*          not connected)                                       *
*  Tcase : node where the boundary contition - external heat    *
*          sinks etc - have to be connected (ideal heat sink    *
*          can be modeled by using a voltage source stating the *
*          ambient temperature in °C between Tcase and ground.  *
*                                                               *
*****************************************************************
*$
.SUBCKT S_100_n_var dd g s Tj PARAMS: a=1 dVth=0 dR=0 dgfs=0 Inn=1 Unn=1 Rmax=1
+mos_gmin=1 Rs=1 Rp=1 dC=0 heat=1
             
.PARAM  Wcml=4.27    c=1.3       Vth0=3.6     auth=3.8m    al=0.5       
.PARAM  aubr=90m     lnBr=-23    Ubr=105      UTnbr=207m   theta=0.1

.PARAM  Rd=170m      nmu=2.9     Tref=298     T0=273       lnIsj=-29.7
.PARAM  ndi=1        Rdi=18m     nmu2=0.5     ta=35n       td=10n
.PARAM  Rf=0.32      ph0=19.5    ph1=32m      rpa=7m

.PARAM  f1=400p      f2=69.5p    f3=130p      U0=900m      Vn=320m
.PARAM  remp=10p     bb=0.15     kbq=85.8u  

.PARAM  Vmin=2.7     Vmax=4.6    dCmax=0.33
.PARAM  Vth={Vth0+(Vmax-Vth0)*limit(dVth,0,1)-(Vmin-Vth0)*limit(dVth,-1,0)}
.PARAM  p1={Unn-Inn*Rs-Vth0}
.PARAM  p0={Wcml*((T0/Tref)**1.5)*a/(1+theta*p1)}
.PARAM  Rlim={(2*Inn*Rmax*c-p1+SQRT(p1**2-4*c/p0*Inn))/(2*c*Inn*(1+rpa*(Inn/a)**2))} 
.PARAM  dRd={Rd/a+if(dVth==0,limit(dR,0,1)*max(Rlim-Rd/a-Rs-Rp,0),0)} 
.PARAM  Ud={(SQRT(1+4*al*abs(Inn*(Rmax-Rd/a*(1+rpa*(Inn/a)**2)-Rs-Rp)))-1)/2/al}  
.PARAM  bm={(Tref/T0)**1.5*Inn/((Unn-Vth-Inn*Rs-c*Ud)*Ud)}
.PARAM  gm={max(mos_gmin,1/(SQRT(c/bm/Inn)+Rs))}
.PARAM  bet={Wcml*if(dR==0,if(dVth==0,1+(1-1/(a*Wcml*Inn/c*(1/gm-Rs)**2))*(limit(dgfs,-1,0)),1),1)}
.PARAM  dC1={1+dCmax*limit(dC,0,1)} 

.PARAM  Cox={f1*a*dC1}
.PARAM  Cds0={f2*a*dC1}
.PARAM  Cgs0={f3*a*dC1}
.PARAM  Crand={remp*SQRT(a)}
.PARAM  dRdi={Rdi/a}

.FUNC I2(p,Uee,z1,pp) {if(Uee>pp,(Uee-c*z1)*z1,p*(pp-p)/c*exp((Uee-pp)/p))}
.FUNC Ig(Uds,T,p,Uee) {bet/(1+max(-0.5,theta*Uee))*(T0/T)**1.5*I2(p,Uee,min(Uds,Uee/(2*c)),min(2*p,p+c*Uds))}
.FUNC Idbr(Uds,T)     {exp(min(lnBr+(Uds-UBr-aubr*(T-Tref))/UTnbr,25))}
.FUNC Iges(Uds,Ugs,T) 
  + {a*(sgn(Uds)*Ig((SQRT(1+4*al*abs(Uds))-1)/2/al,T,1/(ph0-ph1*T),Ugs-Vth+auth*(T-Tref))+Idbr(abs(Uds),T))}

.FUNC Isjt(Tj)           {exp(min(lnIsj+(Tj/Tref-1)*1.12/(ndi*kbq*Tj),9))*Tj/Tref}
.FUNC Idiode(Usd,Tj,Iss) {exp(min(log(Iss)+Usd/(ndi*kbq*Tj),9))-Iss}
.FUNC Idiod(Usd,Tj)      {a*Idiode(Usd,Tj,Isjt(Tj))}

E_Edg     d   ox  VALUE {max(V(d,g),-bb)-3/2*Vn*((1+2*(max(V(d,g)+bb,0))/Vn)**(1/3)-(1+2*bb/Vn)**(1/3))}
C_Cdg    ox    g  {Cox}
C_rand    d    g  {Crand}

E_Eds     d edep  VALUE {(V(d2,s)-I(V_sense3)/Cds0)}
C_Cds  edep    s  {Cds0}
C_Cds2   d2    s  {Cds0/100}

C_Cgs     g    s  {Cgs0}

G_chan    d    s  VALUE={Iges(V(d,s),V(g,s),T0+limit(V(Tj),-200,350))}
E_RMos   d1    d  VALUE={I(V_sense)*(Rf*dRd+(1-Rf)*dRd*((limit(V(Tj),-200,999)+T0)/Tref)**nmu)*(1+rpa*(I(V_sense)/a)**2)}
V_sense  dd   d1  0
G_diode   s   d2  VALUE={Idiod(V(s,d2),T0+limit(V(Tj),-200,499))}
G_Rdio   d2   d3  VALUE={V(d2,d3)/(dRdi*((limit(V(Tj),-200,999)+T0)/Tref)**nmu2)}
V_sense2 d1   d3  0

L_L001    a    c  {td/(ta+td)}
R_R001    a    b  {1/ta}
V_sense3  c    0  0
E_E001    b    0  VALUE {I(V_sense2)}
E_E002    e    0  VALUE {1Meg*Cds0*2*(SQRT(U0*(limit(U0+V(d2,s),0,2*Ubr))))}
R_R002    e    c  1Meg

R1        g    s  1G
Rd01      d    s  500Meg
Rd02     d2    s  500Meg
Rd03     d1    d  1k

G_TH      0   Tj  VALUE = 
 +{heat*(LIMIT(I(V_sense2)*V(d1,s)+(I(V_sense)-I(V_sense2))*V(d1,d)+
 +(I(V_sense)-I(V_sense2)-I(E_Edg)-I(E_Eds))*V(d,s),-10k,100k))}

.ENDS
*$
.SUBCKT S_100_l_var dd g s Tj PARAMS: a=1 dVth=0 dR=0 dgfs=0 Inn=1 Unn=1 Rmax=1
+mos_gmin=1 Rs=1 Rp=1 dC=0 heat=1
             
.PARAM  Wcml=6.36    c=0.9       Vth0=2       auth=2.3m    al=0.5       
.PARAM  aubr=90m     lnBr=-23    Ubr=105      UTnbr=207m   theta=0.2

.PARAM  Rd=170m      nmu=2.9     Tref=298     T0=273       lnIsj=-29.7
.PARAM  ndi=1        Rdi=14m     nmu2=0.5     ta=30n       td=10n
.PARAM  Rf=0.32      ph0=34.8    ph1=65m      rpa=7m

.PARAM  f1=470p      f2=71p      f3=150p      U0=900m      g1=20
.PARAM  remp=5p      bb=0        kbq=85.8u    nc=0.55

.PARAM  Vmin=1.6     Vmax=2.4    dCmax=0.33
.PARAM  Vth={Vth0+(Vmax-Vth0)*limit(dVth,0,1)-(Vmin-Vth0)*limit(dVth,-1,0)}
.PARAM  p1={Unn-Inn*Rs-Vth0}
.PARAM  p0={Wcml*((T0/Tref)**1.5)*a/(1+theta*p1)}
.PARAM  Rlim={(2*Inn*Rmax*c-p1+SQRT(p1**2-4*c/p0*Inn))/(2*c*Inn*(1+rpa*(Inn/a)**2))} 
.PARAM  dRd={Rd/a+if(dVth==0,limit(dR,0,1)*max(Rlim-Rd/a-Rs-Rp,0),0)} 
.PARAM  Ud={(SQRT(1+4*al*abs(Inn*(Rmax-Rd/a*(1+rpa*(Inn/a)**2)-Rs-Rp)))-1)/2/al}  
.PARAM  bm={(Tref/T0)**1.5*Inn/((Unn-Vth-Inn*Rs-c*Ud)*Ud)}
.PARAM  gm={max(mos_gmin,1/(SQRT(c/bm/Inn)+Rs))}
.PARAM  bet={Wcml*if(dR==0,if(dVth==0,1+(1-1/(a*Wcml*Inn/c*(1/gm-Rs)**2))*(limit(dgfs,-1,0)),1),1)}
.PARAM  dC1={1+dCmax*limit(dC,0,1)} 

.PARAM  Cox={f1*a*dC1}
.PARAM  Cds0={f2*a*dC1}
.PARAM  Cgs0={f3*a*dC1}
.PARAM  Crand={remp*SQRT(a)}
.PARAM  dRdi={Rdi/a}

.FUNC I2(p,Uee,z1,pp) {if(Uee>pp,(Uee-c*z1)*z1,p*(pp-p)/c*exp((Uee-pp)/p))}
.FUNC Ig(Uds,T,p,Uee) {bet/(1+max(-0.5,theta*Uee))*(T0/T)**1.5*I2(p,Uee,min(Uds,Uee/(2*c)),min(2*p,p+c*Uds))}
.FUNC Idbr(Uds,T)     {exp(min(lnBr+(Uds-UBr-aubr*(T-Tref))/UTnbr,25))}
.FUNC Iges(Uds,Ugs,T) 
  + {a*(sgn(Uds)*Ig((SQRT(1+4*al*abs(Uds))-1)/2/al,T,1/(ph0-ph1*T),Ugs-Vth+auth*(T-Tref))+Idbr(abs(Uds),T))}

.FUNC Isjt(Tj)           {exp(min(lnIsj+(Tj/Tref-1)*1.12/(ndi*kbq*Tj),9))*Tj/Tref}
.FUNC Idiode(Usd,Tj,Iss) {exp(min(log(Iss)+Usd/(ndi*kbq*Tj),9))-Iss}
.FUNC Idiod(Usd,Tj)      {a*Idiode(Usd,Tj,Isjt(Tj))}

E_Edg     d   ox  VALUE {max(V(d,g),-bb)-(1/(g1*(1-nc))*((1/(1+g1*max(V(d,g)+bb,0)))**(nc-1)-(1/(1+g1*bb))**(nc-1)))}
C_Cdg    ox    g  {Cox}
C_rand    d    g  {Crand}

E_Eds    d  edep  VALUE {(V(d2,s)-I(V_sense3)/Cds0)}
C_Cds  edep    s  {Cds0}
C_Cds2   d2    s  {Cds0/100}

C_Cgs     g    s  {Cgs0}

G_chan    d    s  VALUE={Iges(V(d,s),V(g,s),T0+limit(V(Tj),-200,350))}
E_RMos   d1    d  VALUE={I(V_sense)*(Rf*dRd+(1-Rf)*dRd*((limit(V(Tj),-200,999)+T0)/Tref)**nmu)*(1+rpa*(I(V_sense)/a)**2)}
V_sense  dd   d1  0
G_diode   s   d2  VALUE={Idiod(V(s,d2),T0+limit(V(Tj),-200,499))}
G_Rdio   d2   d3  VALUE={V(d2,d3)/(dRdi*((limit(V(Tj),-200,999)+T0)/Tref)**nmu2)}
V_sense2 d1   d3  0

L_L001    a    c  {td/(ta+td)}
R_R001    a    b  {1/ta}
V_sense3  c    0  0
E_E001    b    0  VALUE {I(V_sense2)}
E_E002    e    0  VALUE {1Meg*Cds0*2*(SQRT(U0*(limit(U0+V(d2,s),0,2*Ubr))))}
R_R002    e    c  1Meg

R1        g    s  1G
Rd01      d    s  500Meg
Rd02     d2    s  500Meg
Rd03     d1    d  1k

G_TH      0   Tj  VALUE = 
 +{heat*(LIMIT(I(V_sense2)*V(d1,s)+(I(V_sense)-I(V_sense2))*V(d1,d)+
 +(I(V_sense)-I(V_sense2)-I(E_Edg)-I(E_Eds))*V(d,s),-10k,100k))}

.ENDS
*$
.SUBCKT SPD11N10 drain gate source Tj Tcase PARAMS: dVth=0 dRdson=0 dgfs=0 dC=0 Zthtype=0

.PARAM Rs=2.97m     Rg=0.5       Rd=50u       Ls=7n        Ld=1n        Lg=6n
.PARAM Inn=7.9      Unn=10       Rmax=164m    mos_gmin=3.38
.PARAM act=2.1

X1  d1 g s Tj S_100_n_var PARAMS: a={act} dVth={dVth} dR={dRdson} dgfs={dgfs} Inn={Inn} Unn={Unn} 
                                        +Rmax={Rmax} mos_gmin={mos_gmin} Rs={Rs} Rp={Rd} dC={dC} heat=1
Rg    g1     g    {Rg}   
Lg    gate   g1   {Lg*if(dgfs==99,0,1)}
Gs    s1     s    VALUE={V(s1,s)/(Rs*(1+(limit(V(Tj),-200,999)-25)*4m))}
Rsa   s1     s    1Meg
Ls    source s1   {Ls*if(dgfs==99,0,1)}
Rda   d1     d2   {Rd}
Ld    drain  d2   {Ld*if(dgfs==99,0,1)}
Rsb   source s1    10
Rga   gate   g1    10
Rdb   drain  d2    10

Rth1  Tj      t1              {15.63m+limit(Zthtype,0,1)*5.78m}
Rth2  t1      t2              {158.64m+limit(Zthtype,0,1)*58.72m}
Rth3  t2      t3              {619.09m+limit(Zthtype,0,1)*281.4m}
Rth4  t3      t4              {717.62m+limit(Zthtype,0,1)*682.8m}
Rth5  t4      Tcase           {492.1m+limit(Zthtype,0,1)*468.22m}
Cth1  Tj      0               29.237u
Cth2  t1      0               71.855u
Cth3  t2      0               942.381u
Cth4  t3      0               370.06u
Cth5  t4      0               28.374m
Cth6  Tcase   0               90m

.ENDS

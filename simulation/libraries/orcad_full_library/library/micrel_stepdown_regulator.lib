.SUBCKT MIC2205 AGND AVIN BIAS EN FB LDO LOWQbar PGND SW VIN  
E_E1         XX_SHUTDWN AGND VALUE { IF(V(BIAS)>2.55,V(EN),0) }
R_R4         PGND AGND  10meg TC=0,0 
E_E3         N10568356 AGND VALUE { IF(V(N01651)<0.85,V(AVIN),0) }
E_E2         XX_BLCKPULSE PGND VALUE { IF(V(LOWQBAR)<0.85,0,5) }
R_R6         AVIN BIAS  0.1 TC=0,0 
E_E4         N03670 AGND FB AGND 1
R_R8         XX_SHUTDWN N00251  2  
C_C8         AGND N00251  1n  TC=0,0
X_Q1         N10568356 N10568360 N10568733 QDarBreakN
E_E123         N10568360 AGND VALUE { {1-V(N10574905)}*1000 }
E_E51         N10568974 AGND VALUE { IF(V(N10568356)>0,{v(N10568733)+0.7},0) }
D_D1         N10568974 LDO Dbreak 
X_U3         XX_BLCKPULSE N00420 N03670 AGND N00251 SW VIN
+  PREG_EXTCOMP_SYNC_RDSON_BLCKPULSE PARAMS:  RDSON_HIGHSIDE=0.4
+  ENABLEACTIVELOWHIGH=1 PERIOD=0.5U REF_VOLTAGE=1 CURRENTLIMIT_PPP=1
+  SHDN_VT=0.85 RDSON_LOWSIDE=0.4 SHDN_VH=0.05 SOFTSTARTTIME=1MS
+  RZ1=5k RZ2=8k CZ1=0.8n CP1=0.001p
E_LIMIT1         N10574905 0 VALUE {LIMIT(V(FB),-1,1)}
*
E_U4A          N10576681 0 VALUE {IF((V(XX_SHUTDWN) >= 0.8),0.4, 3.5)} INV_ABM
E_U5A          N10576688 0 VALUE {IF(((V(XX_SHUTDWN) >= 0.8) & (V(XX_BLCKPULSE)
+  >= 0.8)), 3.5, 0.4)} AND_ABM 
E_U6A          N01651 0 VALUE {IF(((V(N10576681) < 0.8) & (V(N10576688) <
+  0.8)), 0, 5)} OR_ABM 
*
.ENDS
*$

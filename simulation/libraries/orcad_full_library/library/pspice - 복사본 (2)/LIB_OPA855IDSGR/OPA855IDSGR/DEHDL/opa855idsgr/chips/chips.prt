      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='NC';
    'IN-':
      PIN_NUMBER='(3)';
      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='INPUT';
    'IN+':
      PIN_NUMBER='(4)';
      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='INPUT';
    'THERMAL_PAD':
      PIN_NUMBER='(9)';
      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='GROUND';
    'PD*':
      PIN_NUMBER='(8)';
      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;

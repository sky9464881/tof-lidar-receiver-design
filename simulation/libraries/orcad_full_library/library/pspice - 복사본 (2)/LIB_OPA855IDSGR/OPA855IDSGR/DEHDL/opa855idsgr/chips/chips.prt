    PHYS_DES_PREFIX='IC';
    NO_LOAD_CHECK='TRUE';
    PIN_COUNT='9';
    BODY_NAME='OPA855IDSGR';
    JEDEC_TYPE='SON50P200X200X80-9N-D';
  END_BODY;
END_PRIMITIVE;
END.

.SUBCKT MAX708T RESETB RESET MR VCC GND PFI PFO  
VTH VTH 0 DC 3.08V ;{VVTH}
ECOMP1 input 0 VALUE {IF((V(VCC) <= V(VTH) | V(MR) <=0.5 ),0.0, 5.0)}  
vdd vdd 0 dc 5v
vgnd gnd 0 dc 0V
R1 VDD OUT1 4K
COUT1 OUT1 0 0.00001
MN1 GND input OUT1 OUT1 PMOS1 l=10u w=1000000U
R2 VDD OUT2 1K
COUT2 OUT2 0 0.00001
MN2 GND reset1 OUT2 OUT2 PMOS1 l=10u w=1000000U
ERESETB1 RESET1 0 VALUE {IF((V(OUT1) >= 4.95),VOH, VOL)}
ERESET RESET 0 VALUE {IF((V(OUT2) >= 4.95),VOH, VOL)}          
ERESETb RESETB 0 VALUE {IF((V(RESET) >= 4.95),VOL, VOH)}       
*ECOMP2 PFO 0 VALUE {IF((V(PFI) <= 1.25),0.0, VOH)}
.model PMOS1 PMOS LEVEL=3 CBD=1E-9 RDS=1E+06 TT=1n VTO=-3.0
+  RD=0.1 RS=10E-3 RG=0.5 CGSO=1E-9 CGDO=100E-12
*VPFI PFI 0 PULSE 0 5 10U 10U 10U 40U 80U
***********************************
VFIX FIX 0 DC 1.25V
EIN IN 0 VALUE {IF((V(PFI) <= V(FIX)),5.0,V(PFI))}
EPFOB PFOB 0 VALUE {IF((V(OUTP) <= 1.2),5.0,0.0)}
M3 OUTP IN GND GND NMOS L=10U W=1500U
M5 OUTP IN VDD VDD PMOS L=10U W=750U
*************************************

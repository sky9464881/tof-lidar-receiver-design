***************MAX 803 series*******************************************************************
.subckt max803sq463t1g gnd resetb in PARAMS: vcc=5.0
V_V4         VTHN GND 2.3v
V_V3         VTHP GND 2.5v
U_DSTM15         STIM(1,1) $G_DPWR $G_DGND CLK_INTERNAL IO_STM IO_LEVEL=0 
+ 0 0
+ +100u 1
+REPEAT FOREVER
+ +4.82mS 0
+  +4.82mS 1
+ ENDREPEAT
V_V2         VCC GND {vcc}
X_U26         N95569 Q3 RSTIN Q4 M_UN0001 $G_DPWR $G_DGND TFFR
X_U21         N95569 N96061 RSTIN Q1 M_UN0002 $G_DPWR $G_DGND TFFR
X_U22         M_UN0003 M_UN0004 M_UN0005 M_UN0006 M_UN0007 $G_DPWR $G_DGND TFFR
U_DSTM14         STIM(1,1)
+ $G_DPWR $G_DGND
+ N95569 
+ IO_STM
+ IO_LEVEL=0
+  0s 0  
+ 1u 1  
X_U31         RSTIN N98840 N109383 $G_DPWR $G_DGND NAN2
Rx  N109383 nx 10k
E_E2         N109383_x 0 VALUE { IF((V(nx) < 0.8 ),0.0,5.0) }
X_U30         RSTIN LATCH RSTIN N98840 M_UN0008 $G_DPWR $G_DGND DLATR
X_U27         CLK_INTERNAL N96061  $G_DPWR $G_DGND INV
X_U23         M_UN0009 M_UN0010 M_UN0011 M_UN0012 M_UN0013 $G_DPWR $G_DGND TFFR
X_U28         Q4 Q3 Q2 Q1 LATCH $G_DPWR $G_DGND AND4
X_U19         N94871 RSTIN $G_DPWR $G_DGND BUF
X_U24         N95569 Q1 RSTIN Q2 M_UN0014 $G_DPWR $G_DGND TFFR
E_E1         N94871 GND VALUE { IF(V(IN,GND) < v(vcc) & ((v(IN,GND) > v(vthp) 
+  |  (v(IN,GND) > v(vthn))) ),V(IN,GND),IF(V(IN,GND) < v(vcc) & (v(IN,GND) <=
+  v(vthn) ),0.0,v(vcc))) }
X_U25         N95569 Q2 RSTIN Q3 M_UN0015 $G_DPWR $G_DGND TFFR
M_M1         RESETB N109383_x GND GND NMOS1 L=10U W=36U
.MODEL NMOS1 NMOS (LEVEL=1
+PHI=0.600000 
+TOX=2.1500E-08 
+XJ=0.200000U 
+TPG=1  
+VTO=1.00       
+DELTA=9.4090E-01 
+LD=1.3540E-07 
+KP=1.0877E-04 
+UO=680.4
+THETA=8.3620E-02 
+RSH=109.3 
+GAMMA=0.5487 
+NSUB=2.3180E+16 
+NFS=1.98E+12
+VMAX=1.8700E+05 
+ETA=5.5740E-02 
+KAPPA=5.9210E-02 
+CGDO=3.2469E-10
+CGSO=3.2469E-10 
+CGBO=3.7124E-10 
+CJ=3.1786E-04 
+MJ=1.0148
+CJSW=1.3284E-10 
+MJSW=0.119521 
+PB=0.800000)
.ends max803sq463t1g

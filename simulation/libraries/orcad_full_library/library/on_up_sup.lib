****************************************************************************
*
* WARNING : please consider following remarks before usage
*
* 1) All models are a tradeoff between accuracy and complexity (ie. simulation
*    time).
* 2) Macromodels are not a substitute to breadboarding, they rather confirm the
*    validity of a design approach and help to select surrounding component values.
*
* 3) A macromodel emulates the NOMINAL performance of a TYPICAL device within
*    SPECIFIED OPERATING CONDITIONS (ie. temperature, supply voltage, etc.).
*    Thus the macromodel is often not as exhaustive as the datasheet, its goal
*    is to illustrate the main parameters of the product.
*
* 4) Data issued from macromodels used outside of its specified conditions
*    (Vcc, Temperature, etc) or even worse: outside of the device operating
*    conditions (Vcc, Vicm, etc) are not reliable in any way.
*
****************************************************************************
*$
.SUBCKT MAX707 RESETB RESET MR VCC GND PFI PFO NC 
VTH VTH 0 DC 4.63V ;{VVTH}
ECOMP1 input 0 VALUE {IF((V(VCC) <= V(VTH) | V(MR) <=0.5 ),0.0, 5.0)}  
.PARAM VOL=0.0
.PARAM VOH=5.0
vdd vdd 0 dc 5v
*vgnd gnd 0 dc 0V
R1 VDD OUT1 4K
COUT1 OUT1 0 0.00001
MN1 GND input OUT1 OUT1 PMOS1 l=10u w=1000000U
R2 VDD OUT2 1K
COUT2 OUT2 0 0.00001
MN2 GND reset1 OUT2 OUT2 PMOS1 l=10u w=1000000U
ERESETB1 RESET1 0 VALUE {IF((V(OUT1) >= 4.95),VOH, VOL)}
ERESET RESET 0 VALUE {IF((V(OUT2) >= 4.95),VOH, VOL)}          
ERESETb RESETB 0 VALUE {IF((V(RESET) >= 4.95),VOL, VOH)}       
*ECOMP2 PFO 0 VALUE {IF((V(PFI) <= 1.25),0.0, VOH)}
.model PMOS1 PMOS LEVEL=3 CBD=1E-9 RDS=1E+06 TT=1n VTO=-3.0
+  RD=0.1 RS=10E-3 RG=0.5 CGSO=1E-9 CGDO=100E-12
VFIX FIX 0 DC 1.25V
EPFOB PFO 0 VALUE {IF((V(PFI) <= V(FIX)),0.0,5.0)}
************************PRIORLY TRIED TO GET THE VALUES OF SOURC AND SINK CURRENT****
*EIN IN 0 VALUE {IF((V(PFI) <= V(FIX)),5.0,V(PFI))}
*EPFOB PFO 0 VALUE {IF((V(OUTP) <= 4.95),0.0,5.0)}
*M3 OUTP IN GND GND NMOS L=10U W=1500U
*M5 OUTP IN VDD VDD PMOS L=10U W=750U
*coutp outp  0 1n
**************************************************************************************
.MODEL NMOS NMOS (LEVEL=3
+PHI=0.600000 
+TOX=2.1500E-08 
+XJ=0.200000U 
+TPG=1 
+VTO=0.8063
+DELTA=9.4090E-01 
+LD=1.3540E-07 
+KP=1.0877E-04 
+UO=680.4
+THETA=8.3620E-02 
+RSH=109.3 
+GAMMA=0.5487 
+NSUB=2.3180E+16 
+NFS=1.98E+12
+VMAX=1.8700E+05 
+ETA=5.5740E-02 
+KAPPA=5.9210E-02 
+CGDO=3.2469E-10
+CGSO=3.2469E-10 
+CGBO=3.7124E-10 
+CJ=3.1786E-04 
+MJ=1.0148
+CJSW=1.3284E-10 
+MJSW=0.119521 
+PB=0.800000)
.MODEL PMOS PMOS (LEVEL=3 PHI=0.600000
+TOX=2.1500E-08 
+XJ=0.200000U 
+TPG=-1 
+VTO=-0.9403 
+DELTA=8.5790E-01
+LD=1.1650E-09 
+KP=3.4276E-05 
+UO=214.4 
+THETA=1.4010E-01 
+RSH=122.2
+GAMMA=0.5615 
+NSUB=2.4270E+16 
+NFS=3.46E+12 
+VMAX=3.9310E+05
+ETA=1.5670E-01 
+KAPPA=9.9990E+00 
+CGDO=2.7937E-12 
+CGSO=2.7937E-12
+CGBO=3.5981E-10 
+CJ=4.5952E-04 
+MJ=0.4845 
+CJSW=2.7917E-10
+MJSW=0.365250 
+PB=0.850000)
.ENDS MAX707

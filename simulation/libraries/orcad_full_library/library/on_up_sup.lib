V_V7         N127696 0 5Vdc
V_V2         VCC GND {vcc}
X_U26         N127126 Q3 RSTIN Q4 M_UN0014 $G_DPWR $G_DGND TFFR
E_E1         N126840 GND VALUE { IF(V(IN,GND) < v(vcc) & ((v(IN,GND) > v(vthp) 
